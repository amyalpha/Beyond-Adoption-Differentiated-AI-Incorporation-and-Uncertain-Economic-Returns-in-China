    capture confirm variable `candidate'
    if !_rc & `"`aiuse23'"' == "" local aiuse23 `candidate'
}

if `"`panelvar'"' == "" | `"`awareness23'"' == "" |  ///
   `"`familiarity23'"' == "" | `"`aiuse23'"' == "" {
    display as error "One or more required 2023 AI variables are absent."
    log close
    exit 111
}

foreach v in `awareness23' `aiuse23' {
    quietly count if !inlist(`v', 0, 1, .)
    if r(N) > 0 {
        display as error "`v' is expected to use 0=no and 1=yes."
        tabulate `v', missing
        log close
        exit 459
    }
}

gen byte t8_ai_awareness23 = `awareness23'             ///
    if inlist(`awareness23', 0, 1)

quietly count if t8_ai_awareness23 == 1 &               ///
    !missing(`familiarity23') &                         ///
    (`familiarity23' < 0 | `familiarity23' > 20)
if r(N) > 0 {
    display as error "2023 familiarity appears to contain unreplaced special codes."
    summarize `familiarity23' if t8_ai_awareness23 == 1, detail
    log close
    exit 459
}

* Questionnaire routing: respondents who were unaware were not asked the
* familiarity/use follow-ups. Only these structural missings become zero.
* Missing follow-ups among aware respondents remain genuine missing values.
gen double t8_ai_familiarity_route = `familiarity23'    ///
    if t8_ai_awareness23 == 1 & !missing(`familiarity23')
replace t8_ai_familiarity_route = 0 if t8_ai_awareness23 == 0

gen byte t8_prior_ai_use = `aiuse23'                    ///
    if t8_ai_awareness23 == 1 & inlist(`aiuse23', 0, 1)
replace t8_prior_ai_use = 0 if t8_ai_awareness23 == 0

* Standardize familiarity among aware respondents. Assigning zero on this
* centered term to unaware respondents lets the awareness indicator capture
* the aware/unaware contrast, while familiarity captures variation among
* those who had already heard of AI.
quietly summarize `familiarity23' if                    ///
    `panelvar' == 1 & !missing(t8_age) &                 ///
    t8_ai_awareness23 == 1 & !missing(`familiarity23')
if r(N) == 0 | r(sd) == 0 | missing(r(sd)) {
    display as error "2023 AI familiarity has no usable variation among aware respondents."
    log close
    exit 459
}
gen double t8_ai_familiarity_z =                        ///
    (`familiarity23'-r(mean))/r(sd)                     ///
    if t8_ai_awareness23 == 1 & !missing(`familiarity23')
replace t8_ai_familiarity_z = 0 if t8_ai_awareness23 == 0
label define t8_awareness_lbl 0 "Unaware" 1 "Aware", replace
