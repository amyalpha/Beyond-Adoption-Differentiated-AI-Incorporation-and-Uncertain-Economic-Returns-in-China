    if !_rc & `"`panelvar'"' == "" local panelvar `candidate'
}

local awareness23 ""
foreach candidate in ai_awareness_w23 ai_awareness2023 {
    capture confirm variable `candidate'
    if !_rc & `"`awareness23'"' == "" local awareness23 `candidate'
}

local familiarity23 ""
foreach candidate in ai_familiarity_w23 ai_familiar2023 familiarAI_w23 {
