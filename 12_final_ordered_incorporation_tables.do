                 gb_link gt_link pb_link pt_link {
    quietly count if t8_s_`s' == 1
    display as result "`s': " r(N)
}

*--------------------------------------------------------------------*
* 7. MODEL SPECIFICATIONS
*--------------------------------------------------------------------*

local structural25                                       ///
    c.t8_age c.t8_age_sq i.t8_female                   ///
    ib1.t8_education c.t8_ihs_eqincome                 ///
    ib1.t8_empstudent i.t8_hukoulive                   ///
    i.t8_city_tier i.t8_region i.t8_ccp_member         ///
    i.t8_marriage

local structural23                                       ///
    c.t8_age23 c.t8_age23_sq i.t8_female23             ///
    ib1.t8_education23 c.t8_ihs_eqincome23             ///
    i.t8_hasjob23 i.t8_hukoulive23                     ///
    ib1.t8_city_tier23 ib1.t8_region23                 ///
    i.t8_ccp_member23 i.t8_marriage23

local expectations                                       ///
    ib3.t8_income_expect ib3.t8_job_expect

local awareness                                          ///
    i.t8_ai_awareness23

local prior                                              ///
    c.t8_ai_familiarity_z i.t8_prior_ai_use

local devices23                                          ///
    i.t8_phone i.t8_computer                           ///
    c.t8_ihs_phone_value c.t8_ihs_computer_value       ///
    i.t8_phone_value_missing i.t8_computer_value_missing

* Add block-level Wald tests to the active estimation result. Missing values
* indicate that the relevant block has not yet entered that model.
capture program drop t8_add_main_tests
program define t8_add_main_tests
    capture quietly testparm c.t8_age c.t8_age_sq      ///
        i.t8_female i.t8_marriage
    if _rc {
        estadd scalar p_demographic = .
    }
    else {
        local p = r(p)
        estadd scalar p_demographic = `p'
    }

    capture quietly testparm ib1.t8_education          ///
        c.t8_ihs_eqincome ib1.t8_empstudent            ///
        i.t8_ccp_member
    if _rc {
        estadd scalar p_socioeconomic = .
    }
    else {
        local p = r(p)
        estadd scalar p_socioeconomic = `p'
    }

    capture quietly testparm i.t8_hukoulive            ///
        i.t8_city_tier i.t8_region
    if _rc {
        estadd scalar p_geographic = .
    }
    else {
        local p = r(p)
        estadd scalar p_geographic = `p'
    }

    capture quietly testparm ib3.t8_income_expect
    if _rc {
        estadd scalar p_income_expect = .
    }
    else {
        local p = r(p)
        estadd scalar p_income_expect = `p'
    }

    capture quietly testparm ib3.t8_job_expect
    if _rc {
        estadd scalar p_job_expect = .
    }
    else {
        local p = r(p)
        estadd scalar p_job_expect = `p'
    }
end

capture program drop t8_add_linked_tests
program define t8_add_linked_tests
    capture quietly testparm i.t8_phone i.t8_computer  ///
        c.t8_ihs_phone_value c.t8_ihs_computer_value   ///
        i.t8_phone_value_missing i.t8_computer_value_missing
    if _rc {
        estadd scalar p_devices = .
    }
    else {
        local p = r(p)
        estadd scalar p_devices = `p'
    }

    capture quietly testparm i.t8_ai_awareness23
    if _rc {
        estadd scalar p_awareness = .
    }
    else {
        local p = r(p)
        estadd scalar p_awareness = `p'
    }

    capture quietly testparm c.t8_ai_familiarity_z     ///
        i.t8_prior_ai_use
    if _rc {
        estadd scalar p_prior_block = .
    }
    else {
        local p = r(p)
        estadd scalar p_prior_block = `p'
    }
end


*--------------------------------------------------------------------*
* 8. MAIN 2025 ORDERED-LOGIT MODELS
*--------------------------------------------------------------------*

eststo clear

display as text "Estimating Generative AI breadth: M1 and M2"
quietly ologit t8_gai_breadth `structural25'            ///
    if t8_s_gb_m1 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_GB_M1

quietly ologit t8_gai_breadth `structural25' `expectations' ///
    if t8_s_gb_m2 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_GB_M2

display as text "Estimating Generative AI time: M1 and M2"
quietly ologit t8_gai_time4 `structural25'              ///
    if t8_s_gt_m1 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_GT_M1

quietly ologit t8_gai_time4 `structural25' `expectations' ///
    if t8_s_gt_m2 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_GT_M2

display as text "Estimating Specialised AI breadth: M1 and M2"
quietly ologit t8_pai_breadth `structural25'            ///
    if t8_s_pb_m1 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_PB_M1

quietly ologit t8_pai_breadth `structural25' `expectations' ///
    if t8_s_pb_m2 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_PB_M2

display as text "Estimating Specialised AI time: M1 and M2"
quietly ologit t8_pai_time4 `structural25'              ///
    if t8_s_pt_m1 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_PT_M1

quietly ologit t8_pai_time4 `structural25' `expectations' ///
    if t8_s_pt_m2 == 1 [pweight=t8_weight],            ///
    vce(cluster t8_city_cluster)
t8_add_main_tests
eststo T8_PT_M2

* Confirm that adding expectations does not alter the estimation sample.
foreach outcome in GB GT PB PT {
    estimates restore T8_`outcome'_M1
    local t8_n_m1 = e(N)
    estimates restore T8_`outcome'_M2
    local t8_n_m2 = e(N)
    display as result "Main `outcome' N in M1/M2: `t8_n_m1' `t8_n_m2'"
    if `t8_n_m1' != `t8_n_m2' {
        display as error "M1 and M2 do not use the same observations."
        log close
        exit 459
    }
}

* H1b requires a formal comparison across the two AI outcomes. Joint gsem
* models recover the covariance between equation estimates and permit a Wald
* test of equality across all slopes common to the two equations. The test
* establishes whether the structural patterns differ; substantive direction
* must still be assessed from the outcome-specific estimates.
gen byte t8_s_joint_breadth = t8_base_m2 == 1 &         ///
    !missing(t8_gai_breadth, t8_pai_breadth)
gen byte t8_s_joint_time = t8_base_m2 == 1 &            ///
    !missing(t8_gai_time4, t8_pai_time4)

local t8_p_ai_type_breadth = .
capture noisily gsem                                    ///
    (t8_gai_breadth <- `structural25' `expectations', ologit) ///
    (t8_pai_breadth <- `structural25' `expectations', ologit) ///
    if t8_s_joint_breadth == 1 [pweight=t8_weight],     ///
    vce(cluster t8_city_cluster)
if !_rc {
    estimates store T8_H1B_BREADTH
    capture quietly test                               ///
        [t8_gai_breadth=t8_pai_breadth], common
    if !_rc local t8_p_ai_type_breadth = r(p)
}

local t8_p_ai_type_time = .
capture noisily gsem                                    ///
    (t8_gai_time4 <- `structural25' `expectations', ologit) ///
    (t8_pai_time4 <- `structural25' `expectations', ologit) ///
    if t8_s_joint_time == 1 [pweight=t8_weight],        ///
    vce(cluster t8_city_cluster)
if !_rc {
    estimates store T8_H1B_TIME
    capture quietly test [t8_gai_time4=t8_pai_time4], common
    if !_rc local t8_p_ai_type_time = r(p)
}

display as result "Joint p, Generative versus Specialised AI slopes, breadth: `t8_p_ai_type_breadth'"
display as result "Joint p, Generative versus Specialised AI slopes, time: `t8_p_ai_type_time'"

foreach model in T8_GB_M1 T8_GB_M2 T8_PB_M1 T8_PB_M2 {
    estimates restore `model'
    estadd scalar p_ai_type = `t8_p_ai_type_breadth'
    eststo `model', replace
}
foreach model in T8_GT_M1 T8_GT_M2 T8_PT_M1 T8_PT_M2 {
    estimates restore `model'
    estadd scalar p_ai_type = `t8_p_ai_type_time'
    eststo `model', replace
}


*--------------------------------------------------------------------*
* 9. LINKED 2023-2025 ORDERED-LOGIT MODELS
*--------------------------------------------------------------------*

display as text "Estimating linked Generative AI breadth models"
quietly ologit t8_gai_breadth `structural23'             ///
    if t8_s_gb_link == 1 [pweight=t8_weight],           ///
