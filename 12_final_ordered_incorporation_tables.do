tabulate t8_ai_awareness23 `aiuse23', missing
quietly count if t8_ai_awareness23 == 1 &                ///
    missing(t8_ai_familiarity_route)
display as result "Aware respondents missing familiarity: " r(N)
quietly count if t8_ai_awareness23 == 1 & missing(t8_prior_ai_use)
display as result "Aware respondents missing prior use: " r(N)


