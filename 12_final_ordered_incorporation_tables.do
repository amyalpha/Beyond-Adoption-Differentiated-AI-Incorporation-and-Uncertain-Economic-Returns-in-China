*--------------------------------------------------------------------*
* 9B. PROPORTIONAL-ODDS DIAGNOSTIC FOR THE FINAL SPECIFICATIONS
*--------------------------------------------------------------------*

* brant is user written and may not be installed on an offline system. The
* diagnostic is nonfatal because some versions do not accept survey weights.
capture which brant
if _rc {
    display as text "Brant diagnostic not run: command brant is unavailable."
    display as text "Use a generalized ordered logit sensitivity analysis before submission."
}
else {
    foreach model in T8_GB_M2 T8_GT_M2 T8_PB_M2 T8_PT_M2 ///
                     T8_GB_L4 T8_GT_L4 T8_PB_L4 T8_PT_L4 {
        display as text "Proportional-odds diagnostic for `model':"
        estimates restore `model'
        capture noisily brant, detail
        if _rc {
            display as text "brant could not evaluate `model' with its current weight/VCE specification."
        }
    }
}


