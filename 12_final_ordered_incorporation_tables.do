    !missing(t8_pai_time4)
gen byte t8_s_pt_m2 = t8_s_pt_m1

* Linked common samples: L1-L4 use the same observations for each outcome.
gen byte t8_s_gb_link = t8_linked_complete == 1 & !missing(t8_gai_breadth)
gen byte t8_s_gt_link = t8_linked_complete == 1 & !missing(t8_gai_time4)
