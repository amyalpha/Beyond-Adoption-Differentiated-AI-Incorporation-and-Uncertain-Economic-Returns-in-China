    replace t8_gai_time4 = 2 if `gaiuse' == 1 & `gaitime' == 2
    replace t8_gai_time4 = 3 if `gaiuse' == 1 & inrange(`gaitime', 3, 6)
}
else {
    replace t8_gai_time4 = 1 if `gaiuse' == 1 &         ///
        `gaitime' > 0 & `gaitime' <= .5
    replace t8_gai_time4 = 2 if `gaiuse' == 1 &         ///
        `gaitime' > .5 & `gaitime' <= 1
    replace t8_gai_time4 = 3 if `gaiuse' == 1 &         ///
        `gaitime' > 1 & `gaitime' <= 24
}

