*--------------------------------------------------------------------*
* 2. CONSTRUCT STRUCTURAL-POSITION VARIABLES
*--------------------------------------------------------------------*

gen double t8_weight = `weightvar'
replace t8_weight = . if t8_weight <= 0

gen byte t8_age = .
if `"`agevar'"' != "" {
    replace t8_age = `agevar' if inrange(`agevar', 16, 65)
}
else {
    replace t8_age = 2025-`birthyearvar'                ///
        if inrange(2025-`birthyearvar', 16, 65)
}
gen double t8_age_sq = t8_age^2 if !missing(t8_age)

quietly count if !inlist(`sexvar', 1, 2, .)
if r(N) > 0 {
    display as error "`sexvar' is expected to use 1=male and 2=female."
    tabulate `sexvar', missing
    log close
    exit 459
}
gen byte t8_female = `sexvar' == 2 if !missing(`sexvar')
label define t8_female_lbl 0 "Male" 1 "Female", replace
label values t8_female t8_female_lbl

gen byte t8_education = .
replace t8_education = 1 if inrange(`educationvar', 0, 2)
replace t8_education = 2 if inlist(`educationvar', 3, 4)
replace t8_education = 3 if inrange(`educationvar', 5, 7)
label define t8_education_lbl                            ///
    1 "Compulsory education or less"                   ///
    2 "Upper-secondary or vocational"                 ///
    3 "Tertiary education", replace
label values t8_education t8_education_lbl

* IHS is defined for zero and negative income and reduces right skew.
gen double t8_eqincome_10k = `eqincomevar'/10000          ///
    if !missing(`eqincomevar')
gen double t8_ihs_eqincome = asinh(t8_eqincome_10k)
label variable t8_ihs_eqincome                           ///
    "IHS equivalized household income, 2024"

quietly count if !inlist(`jobvar', 0, 1, .)
if r(N) > 0 {
    display as error "`jobvar' is expected to use 0=no and 1=yes."
    tabulate `jobvar', missing
    log close
    exit 459
}
gen byte t8_hasjob = `jobvar'

* inschool_w25 has already been coded for all respondents, including zero
* for respondents above age 30 who are not in school.
quietly count if !inlist(`schoolvar', 0, 1, .)
if r(N) > 0 {
    display as error "`schoolvar' is expected to use 0=no and 1=yes."
    tabulate `schoolvar', missing
    log close
    exit 459
}
gen byte t8_student = `schoolvar' if inlist(`schoolvar', 0, 1)

* Four mutually exclusive employment-education positions.
gen byte t8_empstudent = .
replace t8_empstudent = 1 if t8_hasjob == 1 & t8_student == 0
replace t8_empstudent = 2 if t8_hasjob == 1 & t8_student == 1
replace t8_empstudent = 3 if t8_hasjob == 0 & t8_student == 1
replace t8_empstudent = 4 if t8_hasjob == 0 & t8_student == 0
label define t8_empstudent_lbl                            ///
    1 "Employed, not in school"                        ///
    2 "Employed and in school"                        ///
    3 "In school, not employed"                       ///
    4 "Neither employed nor in school", replace
label values t8_empstudent t8_empstudent_lbl

clonevar t8_hukoulive = `hukouvar'
clonevar t8_city_tier = `citytiervar'
clonevar t8_region = `regionvar'
clonevar t8_marriage = `marriagevar'

* Replace Chinese value labels with English labels in the generated copies.
label define t8_city_tier_en                             ///
    1 "First-tier and new first-tier cities"           ///
    2 "Second-tier cities"                             ///
    3 "Third-tier cities and below", replace
label values t8_city_tier t8_city_tier_en
label variable t8_city_tier "City tier"

label define t8_region_en                                ///
    1 "East"                                           ///
    2 "Central"                                        ///
    3 "West"                                           ///
    4 "Northeast", replace
label values t8_region t8_region_en
label variable t8_region "Region"

* CCP membership: code 1 as CCP member and documented nonmember/other
* categories 0 and 2-4 as not a CCP member. Special codes remain missing.
tabulate `partyvar', missing
gen byte t8_ccp_member = .
replace t8_ccp_member = 1 if `partyvar' == 1
replace t8_ccp_member = 0 if inlist(`partyvar', 0, 2, 3, 4)
label define t8_ccp_lbl 0 "Not a CCP member" 1 "CCP member", replace
label values t8_ccp_member t8_ccp_lbl

* 2023 device ownership and value. Prices are expressed in thousand yuan
* and transformed with IHS. Nonowners receive price zero. Among owners,
* missing prices are median-imputed and flagged in the regression.
foreach v in `phonevar' `computervar' {
    quietly count if !inlist(`v', 0, 1, .)
    if r(N) > 0 {
        display as error "`v' is expected to use 0=no and 1=yes."
        tabulate `v', missing
        log close
        exit 459
    }
}

gen byte t8_phone = `phonevar'
gen byte t8_computer = `computervar'
label define t8_device_lbl 0 "Does not own" 1 "Owns", replace
label values t8_phone t8_computer t8_device_lbl

gen double t8_ihs_phone_value =                         ///
    asinh(`phonevaluevar'/1000)                         ///
    if t8_phone == 1 & `phonevaluevar' >= 0 &           ///
    !missing(`phonevaluevar')
replace t8_ihs_phone_value = 0 if t8_phone == 0
gen byte t8_phone_value_missing =                       ///
    t8_phone == 1 & missing(t8_ihs_phone_value)         ///
    if !missing(t8_phone)
quietly summarize t8_ihs_phone_value if                 ///
    t8_phone == 1 & !missing(t8_ihs_phone_value), detail
local t8_phone_median = 0
if r(N) > 0 local t8_phone_median = r(p50)
replace t8_ihs_phone_value = `t8_phone_median'          ///
    if t8_phone_value_missing == 1

gen double t8_ihs_computer_value =                      ///
    asinh(`computervaluevar'/1000)                      ///
    if t8_computer == 1 & `computervaluevar' >= 0 &     ///
    !missing(`computervaluevar')
replace t8_ihs_computer_value = 0 if t8_computer == 0
gen byte t8_computer_value_missing =                    ///
    t8_computer == 1 & missing(t8_ihs_computer_value)   ///
    if !missing(t8_computer)
quietly summarize t8_ihs_computer_value if              ///
    t8_computer == 1 & !missing(t8_ihs_computer_value), detail
local t8_computer_median = 0
if r(N) > 0 local t8_computer_median = r(p50)
replace t8_ihs_computer_value = `t8_computer_median'    ///
    if t8_computer_value_missing == 1

label variable t8_phone "Phone ownership in 2023"
label variable t8_computer "Computer ownership in 2023"
label variable t8_ihs_phone_value "IHS phone value in 2023"
label variable t8_ihs_computer_value "IHS computer value in 2023"

display as text "2023 device audit:"
tabulate t8_phone, missing
tabulate t8_computer, missing
summarize `phonevaluevar' `computervaluevar'             ///
    t8_ihs_phone_value t8_ihs_computer_value, detail

