* Time may be stored either as questionnaire codes 1-6 or as approximate
* hours. In either format the resulting outcome has four ordered levels.
gen byte t8_gai_time4 = 0 if `gaiuse' == 0
quietly count if `gaiuse' == 1 & !missing(`gaitime')
local t8_gai_time_n = r(N)
quietly count if `gaiuse' == 1 & !missing(`gaitime') &   ///
    !inlist(`gaitime', 1, 2, 3, 4, 5, 6)
local t8_gai_time_noncode = r(N)
if `t8_gai_time_n' == 0 {
