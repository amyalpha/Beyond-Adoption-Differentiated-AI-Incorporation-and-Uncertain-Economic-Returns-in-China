version 16.0
set more off

/*
    TABLES 2 AND 3: ORDERED AI INCORPORATION IN 2025

    Run with the final person-level WIDE dataset already open.
    This file does not load, merge, append, reshape, or overwrite the data.

    Main 2025 analysis, respondents aged 16-65:
      M1  Structural position
      M2  M1 + household-income and job-stability expectations

    IMPORTANT UNIT-OF-ANALYSIS RULE:
      The AI outcomes must belong to the person whose age, education,
      employment, and other characteristics enter the model. If household
      questionnaire AI answers have been copied to every household member,
      specify the respondent-indicator variables below. The file stops rather
      than arbitrarily selecting a household member.

    Linked 2023-2025 analysis (the same observations in L1-L4
    within each outcome):
      L1  2023 structural position
      L2  L1 + 2023 phone/computer ownership and values
      L3  L2 + 2023 AI awareness
      L4  L3 + 2023 AI familiarity and AI use

    Outcomes, estimated separately for Generative AI and Specialised AI:
      1. Breadth: nonuse, one tool, two-five tools, more than five tools
      2. Daily time: nonuse, <=0.5 hour, 0.5-1 hour, >1 hour

    All outcomes are ordinal and are estimated with ordered logit models.
*/


*--------------------------------------------------------------------*
* 0. OUTPUT, LOG, AND CLEANUP
*--------------------------------------------------------------------*

if `"$project_root"' == "" global project_root "."

* The AI module comes from the household questionnaire, so household weights
* are the default. Change this to "individual" only if the released AI module
* independently sampled persons rather than one respondent per household.
local ai_analysis_weight "household"

global t8_results "$project_root/results/main_tables"
global t8_tables  "$t8_results/tables"
global t8_logs    "$t8_results/logs"

capture mkdir "$project_root/results"
capture mkdir "$t8_results"
capture mkdir "$t8_tables"
capture mkdir "$t8_logs"

capture log close _all
log using "$t8_logs/12_final_ordered_incorporation_tables.log", ///
    text replace

* Drop only variables generated by this do-file on an earlier run.
capture drop t8_*

capture which esttab
if _rc {
    display as error "The estout package is required. Install it once with:"
    display as error "ssc install estout"
    log close
    exit 199
}


