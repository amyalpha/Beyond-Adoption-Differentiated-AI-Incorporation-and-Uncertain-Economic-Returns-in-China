    t8_ihs_eqincome23 t8_hasjob23 t8_hukoulive23        ///
    t8_city_tier23 t8_region23 t8_ccp_member23          ///
    t8_marriage23 t8_weight t8_city_cluster
egen byte t8_miss_structural23 = rowmiss(`structural23_vars')

* Common linked sample for L1-L4. The 2025 age restriction defines the
