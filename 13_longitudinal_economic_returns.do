version 16.0
set more off

/*
    TABLE 4: PRIOR AI ENGAGEMENT AND SUBSEQUENT ECONOMIC OUTCOMES

    Run this file with the final person-level WIDE dataset already open.
    It does not load, merge, append, reshape, or overwrite the data.

    Outcomes reported in 2025 for calendar year 2024:
      A. Total reported individual income
      B. Equivalized household income
      C. Annual working hours

    Each outcome is estimated prospectively, conditional on its value for
    calendar year 2022 as reported in the 2023 survey.

      R1  Baseline outcome + 2023 structural position
      R2  R1 + 2023 phone/computer ownership and values
      R3  R2 + 2023 AI awareness
      R4  R3 + 2023 AI familiarity and AI use

    R1-R4 use exactly the same observations within each outcome.
    A separate robustness table models the raw 2022-2024 change score.
    These are prospective associations, not causal estimates.

    The 2023 AI measures must be attached to the person who answered the
    household AI module. The file stops if those values appear on multiple
    household-member records and no respondent flag is supplied below.
*/


*--------------------------------------------------------------------*
* 0. OUTPUT, LOG, AND CLEANUP
*--------------------------------------------------------------------*

if `"$project_root"' == "" global project_root "."

* Household weights are the default because the AI module comes from the
* household questionnaire. Change to "individual" only if the released AI
* module independently sampled persons.
local ai_analysis_weight "household"

global t13_results "$project_root/results/main_tables"
global t13_tables  "$t13_results/tables"
global t13_logs    "$t13_results/logs"

capture mkdir "$project_root/results"
capture mkdir "$t13_results"
capture mkdir "$t13_tables"
capture mkdir "$t13_logs"

capture log close _all
log using "$t13_logs/13_longitudinal_economic_returns.log", ///
    text replace

* Drop only variables generated by an earlier run of this file.
capture drop t13_*

capture which esttab
if _rc {
    display as error "The estout package is required. Install it once with:"
    display as error "ssc install estout"
    log close
    exit 199
}


*--------------------------------------------------------------------*
* 1. IDENTIFIERS AND LINKED-SAMPLE INDICATOR
*--------------------------------------------------------------------*

foreach id in hhid pline {
    capture confirm variable `id'
    if _rc {
        display as error "Required identifier `id' is absent."
        log close
        exit 111
    }
}

capture isid hhid pline
if _rc {
    display as error "hhid + pline do not uniquely identify the wide data."
    duplicates report hhid pline
    log close
    exit 459
}

local panelvar ""
foreach candidate in panel_w23_w25 tracked_panel_w23_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`panelvar'"' == "" local panelvar `candidate'
}
if `"`panelvar'"' == "" {
    display as error "No 2023-2025 linked-person indicator was found."
    log close
    exit 111
}


*--------------------------------------------------------------------*
* 2. LOCATE 2023 STRUCTURAL-POSITION VARIABLES
*--------------------------------------------------------------------*

local age25var ""
foreach candidate in age_w25 age2025 {
    capture confirm variable `candidate'
    if !_rc & `"`age25var'"' == "" local age25var `candidate'
}

local birthyear25var ""
foreach candidate in birthyear_w25 birthy_w25 birthyear2025 {
    capture confirm variable `candidate'
    if !_rc & `"`birthyear25var'"' == "" local birthyear25var `candidate'
}
if `"`age25var'"' == "" & `"`birthyear25var'"' == "" {
    display as error "Neither 2025 age nor 2025 birth year was found."
    log close
    exit 111
}

local age23var ""
foreach candidate in age_w23 age2023 {
    capture confirm variable `candidate'
    if !_rc & `"`age23var'"' == "" local age23var `candidate'
}

local birthyear23var ""
foreach candidate in birthyear_w23 birthy_w23 birthyear2023 {
    capture confirm variable `candidate'
    if !_rc & `"`birthyear23var'"' == "" local birthyear23var `candidate'
}
if `"`age23var'"' == "" & `"`birthyear23var'"' == "" {
    display as error "Neither 2023 age nor 2023 birth year was found."
    log close
    exit 111
}

local sex23var ""
foreach candidate in sex_w23 sex2023 {
    capture confirm variable `candidate'
    if !_rc & `"`sex23var'"' == "" local sex23var `candidate'
}

local education23var ""
foreach candidate in education_w23 edulev_w23 education2023 {
    capture confirm variable `candidate'
    if !_rc & `"`education23var'"' == "" local education23var `candidate'
}

local marriage23var ""
foreach candidate in marriage_w23 marriage2023 {
    capture confirm variable `candidate'
    if !_rc & `"`marriage23var'"' == "" local marriage23var `candidate'
}

local job23var ""
foreach candidate in havejob_w23 havejob2023 {
    capture confirm variable `candidate'
    if !_rc & `"`job23var'"' == "" local job23var `candidate'
}

local job25var ""
foreach candidate in havejob_w25 havejob2025 {
    capture confirm variable `candidate'
    if !_rc & `"`job25var'"' == "" local job25var `candidate'
}

local hukou23var ""
foreach candidate in hukouknlv_w23 hukounlive_w23 hukouknlv1_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`hukou23var'"' == "" local hukou23var `candidate'
}

local citytier23var ""
foreach candidate in city_level_w23 citylevel_w23 city_level2023 {
    capture confirm variable `candidate'
    if !_rc & `"`citytier23var'"' == "" local citytier23var `candidate'
}

local region23var ""
foreach candidate in region_w23 region2023 {
    capture confirm variable `candidate'
    if !_rc & `"`region23var'"' == "" local region23var `candidate'
}

local party23var ""
foreach candidate in party_w23 partym_w23 party2023 party_member_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`party23var'"' == "" local party23var `candidate'
}

local required_aliases sex23var education23var marriage23var       ///
                       job23var job25var hukou23var                 ///
                       citytier23var region23var party23var
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required wave-specific alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 3. LOCATE INCOME, INDUSTRY, DEVICE, AND AI VARIABLES
*--------------------------------------------------------------------*

local indincome23 ""
foreach candidate in ind_income_w23 total_reported_income_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`indincome23'"' == "" local indincome23 `candidate'
}

local indincome25 ""
foreach candidate in ind_income_w25 total_reported_income_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`indincome25'"' == "" local indincome25 `candidate'
}

local eqincome23 ""
foreach candidate in eq_income_w23 eq_income_alt_w23    ///
                         eqincome_w23 eqincome1_w23      ///
                         equivalized_income_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`eqincome23'"' == "" local eqincome23 `candidate'
}

local eqincome25 ""
foreach candidate in eq_income_w25 eq_income_alt_w25    ///
                         eqincome_w25 eqincome1_w25      ///
                         equivalized_income_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`eqincome25'"' == "" local eqincome25 `candidate'
}

local industry23 ""
foreach candidate in industry_w23 industry2023 {
    capture confirm variable `candidate'
    if !_rc & `"`industry23'"' == "" local industry23 `candidate'
}

local phone23 ""
foreach candidate in have_phone_w23 havephone_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`phone23'"' == "" local phone23 `candidate'
}

local computer23 ""
foreach candidate in have_computer_w23 havecpt_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`computer23'"' == "" local computer23 `candidate'
}

local phonevalue23 ""
foreach candidate in phone_value_w23 phonevalue_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`phonevalue23'"' == "" local phonevalue23 `candidate'
}

local computervalue23 ""
foreach candidate in computer_value_w23 cptvalue_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`computervalue23'"' == "" local computervalue23 `candidate'
}

local awareness23 ""
foreach candidate in ai_awareness_w23 ai_awareness2023 {
    capture confirm variable `candidate'
    if !_rc & `"`awareness23'"' == "" local awareness23 `candidate'
}

local familiarity23 ""
foreach candidate in ai_familiarity_w23 ai_familiar2023 familiarAI_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`familiarity23'"' == "" local familiarity23 `candidate'
}

local aiuse23 ""
foreach candidate in ai_use_w23 ai_use2023 useAI_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`aiuse23'"' == "" local aiuse23 `candidate'
}

local required_aliases indincome23 indincome25 eqincome23 eqincome25 ///
                       industry23 phone23 computer23                  ///
                       phonevalue23 computervalue23                  ///
                       awareness23 familiarity23 aiuse23
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required wave-specific alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 4. LOCATE WORK-HOUR COMPONENTS AND SURVEY DESIGN VARIABLES
*--------------------------------------------------------------------*

local workmonths23 ""
foreach candidate in workmonths_w23 workmth_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`workmonths23'"' == "" local workmonths23 `candidate'
}
local workdays23 ""
foreach candidate in workdays_w23 workday_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`workdays23'"' == "" local workdays23 `candidate'
}
local workhours23 ""
foreach candidate in workhours_w23 workhor_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`workhours23'"' == "" local workhours23 `candidate'
}
local worktime23 ""
foreach candidate in worktime_w23 annual_workhours_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`worktime23'"' == "" local worktime23 `candidate'
}

local workmonths25 ""
foreach candidate in workmonths_w25 workmth_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`workmonths25'"' == "" local workmonths25 `candidate'
}
local workdays25 ""
foreach candidate in workdays_w25 workday_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`workdays25'"' == "" local workdays25 `candidate'
}
local workhours25 ""
foreach candidate in workhours_w25 workhor_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`workhours25'"' == "" local workhours25 `candidate'
}
local worktime25 ""
foreach candidate in worktime_w25 annual_workhours_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`worktime25'"' == "" local worktime25 `candidate'
}

local components23 0
if `"`workmonths23'"' != "" & `"`workdays23'"' != "" & ///
   `"`workhours23'"' != "" local components23 1

local components25 0
if `"`workmonths25'"' != "" & `"`workdays25'"' != "" & ///
   `"`workhours25'"' != "" local components25 1

if !`components23' & `"`worktime23'"' == "" {
    display as error "No usable 2023 work-hour components or annual-hours variable was found."
    log close
    exit 111
}
if !`components25' & `"`worktime25'"' == "" {
    display as error "No usable 2025 work-hour components or annual-hours variable was found."
    log close
    exit 111
}

local indweight25 ""
foreach candidate in individual_weight_w25 weight_ind_w25 wgt_ind_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`indweight25'"' == "" local indweight25 `candidate'
}

local hhweight25 ""
foreach candidate in household_weight_w25 weight_hh_w25 wgt_hh_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`hhweight25'"' == "" local hhweight25 `candidate'
}

local provincevar ""
foreach candidate in province_w25 prov_code_w25 province_w23 prov_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`provincevar'"' == "" local provincevar `candidate'
}

local cityvar ""
foreach candidate in city_w25 city_code_w25 city_w23 city_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`cityvar'"' == "" local cityvar `candidate'
}

local required_aliases indweight25 hhweight25 provincevar cityvar
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required survey-design alias `alias' was not found."
        log close
        exit 111
    }
}

display as text "Variables selected for the return analysis:"
display as result "Individual income: `indincome23' / `indincome25'"
display as result "Equivalized household income: `eqincome23' / `eqincome25'"
display as result "2023 devices: `phone23', `computer23', `phonevalue23', `computervalue23'"
display as result "2023 AI: `awareness23', `familiarity23', `aiuse23'"
if `components23' {
    display as result "2023 work hours reconstructed from `workmonths23', `workdays23', `workhours23'"
}
else {
    display as result "2023 work hours taken from `worktime23'"
}
if `components25' {
    display as result "2025 work hours reconstructed from `workmonths25', `workdays25', `workhours25'"
}
else {
    display as result "2025 work hours taken from `worktime25'"
}


*--------------------------------------------------------------------*
* 5. CONSTRUCT AGE, DEMOGRAPHIC, AND STRUCTURAL VARIABLES
*--------------------------------------------------------------------*

gen double t13_age25 = .
if `"`age25var'"' != "" {
    replace t13_age25 = `age25var' if inrange(`age25var', 16, 65)
}
else {
    replace t13_age25 = 2025-`birthyear25var'            ///
        if inrange(2025-`birthyear25var', 16, 65)
}

gen double t13_age23 = .
if `"`age23var'"' != "" {
    replace t13_age23 = `age23var' if inrange(`age23var', 0, 100)
}
else {
    replace t13_age23 = 2023-`birthyear23var'            ///
        if inrange(2023-`birthyear23var', 0, 100)
}
gen double t13_age23_sq = t13_age23^2 if !missing(t13_age23)

quietly count if !inlist(`sex23var', 1, 2, .)
if r(N) > 0 {
    display as error "`sex23var' is expected to use 1=male and 2=female."
    tabulate `sex23var', missing
    log close
    exit 459
}
gen byte t13_female23 = `sex23var' == 2 if !missing(`sex23var')
label define t13_female_lbl 0 "Male" 1 "Female", replace
label values t13_female23 t13_female_lbl

gen byte t13_education23 = .
replace t13_education23 = 1 if inrange(`education23var', 0, 2)
replace t13_education23 = 2 if inlist(`education23var', 3, 4)
replace t13_education23 = 3 if inrange(`education23var', 5, 7)
label define t13_education_lbl                          ///
    1 "Compulsory education or less"                   ///
    2 "Upper-secondary or vocational"                 ///
    3 "Tertiary education", replace
label values t13_education23 t13_education_lbl

foreach v in `job23var' `job25var' {
    quietly count if !inlist(`v', 0, 1, .)
    if r(N) > 0 {
        display as error "`v' is expected to use 0=no and 1=yes."
        tabulate `v', missing
        log close
        exit 459
    }
}
gen byte t13_job23 = `job23var'
gen byte t13_job25 = `job25var'
label define t13_job_lbl 0 "Not employed" 1 "Employed", replace
label values t13_job23 t13_job25 t13_job_lbl

clonevar t13_marriage23 = `marriage23var'
clonevar t13_hukoulive23 = `hukou23var'
clonevar t13_city_tier23 = `citytier23var'
clonevar t13_region23 = `region23var'

label define t13_city_tier_en                           ///
    1 "First-tier and new first-tier cities"           ///
    2 "Second-tier cities"                             ///
    3 "Third-tier cities and below", replace
label values t13_city_tier23 t13_city_tier_en

label define t13_region_en                              ///
    1 "East"                                           ///
    2 "Central"                                        ///
    3 "West"                                           ///
    4 "Northeast", replace
label values t13_region23 t13_region_en

gen byte t13_ccp23 = .
replace t13_ccp23 = 1 if `party23var' == 1
replace t13_ccp23 = 0 if inlist(`party23var', 0, 2, 3, 4)
label define t13_ccp_lbl 0 "Not a CCP member" 1 "CCP member", replace
label values t13_ccp23 t13_ccp_lbl

gen int t13_industry23 = `industry23' if inrange(`industry23', 1, 13)
replace t13_industry23 = 14 if `industry23' == 7777 | `industry23' == 14
label define t13_industry_en                            ///
    1  "Agriculture, forestry, livestock and fishery"  ///
    2  "Mining and manufacturing"                      ///
    3  "Construction"                                  ///
    4  "Utilities"                                     ///
    5  "Wholesale and retail"                          ///
    6  "Transport, storage and postal services"        ///
    7  "Accommodation and catering"                    ///
    8  "Information, software and IT services"         ///
    9  "Finance"                                       ///
    10 "Real estate"                                   ///
    11 "Science, education, culture and health"        ///
    12 "Resident, repair and other services"           ///
    13 "Public administration and social organizations" ///
    14 "Other industry", replace
label values t13_industry23 t13_industry_en

gen double t13_ind_weight = `indweight25'
replace t13_ind_weight = . if t13_ind_weight <= 0
gen double t13_hh_weight = `hhweight25'
replace t13_hh_weight = . if t13_hh_weight <= 0

gen double t13_ai_weight = .
if `"`ai_analysis_weight'"' == "household" {
    replace t13_ai_weight = t13_hh_weight
}
else if `"`ai_analysis_weight'"' == "individual" {
    replace t13_ai_weight = t13_ind_weight
}
else {
    display as error "ai_analysis_weight must be household or individual."
    log close
    exit 198
}
label variable t13_ai_weight                            ///
    "Configured survey weight for AI-respondent analyses"
display as result "AI respondent analysis weight: `ai_analysis_weight'"

egen int t13_province = group(`provincevar')
egen long t13_city_cluster = group(`provincevar' `cityvar')


*--------------------------------------------------------------------*
* 6. CONSTRUCT 2023 DIGITAL-RESOURCE VARIABLES
*--------------------------------------------------------------------*

foreach v in `phone23' `computer23' {
    quietly count if !inlist(`v', 0, 1, .)
    if r(N) > 0 {
        display as error "`v' is expected to use 0=no and 1=yes."
        tabulate `v', missing
        log close
        exit 459
    }
}

gen byte t13_phone23 = `phone23'
gen byte t13_computer23 = `computer23'
label define t13_device_lbl 0 "Does not own" 1 "Owns", replace
label values t13_phone23 t13_computer23 t13_device_lbl

* Values are expressed in thousand yuan and IHS-transformed. Nonowners
* receive zero. Missing values among owners are median-imputed and flagged.
gen double t13_ihs_phonevalue23 =                       ///
    asinh(`phonevalue23'/1000)                          ///
    if t13_phone23 == 1 & `phonevalue23' >= 0 &         ///
       !missing(`phonevalue23')
replace t13_ihs_phonevalue23 = 0 if t13_phone23 == 0
gen byte t13_phonevalue_miss =                          ///
    t13_phone23 == 1 & missing(t13_ihs_phonevalue23)    ///
    if !missing(t13_phone23)
quietly summarize t13_ihs_phonevalue23 if              ///
    t13_phone23 == 1 & !missing(t13_ihs_phonevalue23), detail
local t13_phone_median = 0
if r(N) > 0 local t13_phone_median = r(p50)
replace t13_ihs_phonevalue23 = `t13_phone_median'       ///
    if t13_phonevalue_miss == 1

gen double t13_ihs_computervalue23 =                    ///
    asinh(`computervalue23'/1000)                       ///
    if t13_computer23 == 1 & `computervalue23' >= 0 &   ///
       !missing(`computervalue23')
replace t13_ihs_computervalue23 = 0 if t13_computer23 == 0
gen byte t13_computervalue_miss =                       ///
    t13_computer23 == 1 & missing(t13_ihs_computervalue23) ///
    if !missing(t13_computer23)
quietly summarize t13_ihs_computervalue23 if            ///
    t13_computer23 == 1 & !missing(t13_ihs_computervalue23), detail
local t13_computer_median = 0
if r(N) > 0 local t13_computer_median = r(p50)
replace t13_ihs_computervalue23 = `t13_computer_median' ///
    if t13_computervalue_miss == 1

label variable t13_phone23 "Phone ownership in 2023"
label variable t13_computer23 "Computer ownership in 2023"
label variable t13_ihs_phonevalue23 "IHS phone value in 2023"
label variable t13_ihs_computervalue23 "IHS computer value in 2023"


*--------------------------------------------------------------------*
* 7. CONSTRUCT NESTED 2023 AI COGNITION AND PRACTICE
*--------------------------------------------------------------------*

foreach v in `awareness23' `aiuse23' {
    quietly count if !inlist(`v', 0, 1, .)
    if r(N) > 0 {
        display as error "`v' is expected to use 0=no and 1=yes."
        tabulate `v', missing
        log close
        exit 459
    }
}

gen byte t13_awareness23 = `awareness23'                ///
    if inlist(`awareness23', 0, 1)

quietly count if t13_awareness23 == 1 &                 ///
    !missing(`familiarity23') &                         ///
    (`familiarity23' < 0 | `familiarity23' > 20)
if r(N) > 0 {
    display as error "2023 familiarity appears to contain special codes."
    summarize `familiarity23' if t13_awareness23 == 1, detail
    log close
    exit 459
}

* Only missings created by questionnaire routing are recoded. Genuine
* follow-up nonresponse among aware respondents remains missing.
gen double t13_familiarity_route = `familiarity23'      ///
    if t13_awareness23 == 1 & !missing(`familiarity23')
replace t13_familiarity_route = 0 if t13_awareness23 == 0

gen byte t13_aiuse23 = `aiuse23'                        ///
    if t13_awareness23 == 1 & inlist(`aiuse23', 0, 1)
replace t13_aiuse23 = 0 if t13_awareness23 == 0

* Familiarity is centered and standardized among aware respondents. Zero
* is assigned to unaware respondents so awareness captures the initial
* cognitive threshold and familiarity captures the within-aware gradient.
quietly summarize `familiarity23' if                    ///
    `panelvar' == 1 & !missing(t13_age25) &              ///
    t13_awareness23 == 1 & !missing(`familiarity23')
if r(N) == 0 | r(sd) == 0 | missing(r(sd)) {
    display as error "AI familiarity has no usable variation among aware respondents."
    log close
    exit 459
}
gen double t13_familiarity_z23 =                        ///
    (`familiarity23'-r(mean))/r(sd)                     ///
    if t13_awareness23 == 1 & !missing(`familiarity23')
replace t13_familiarity_z23 = 0 if t13_awareness23 == 0

label define t13_awareness_lbl 0 "Unaware" 1 "Aware", replace
label values t13_awareness23 t13_awareness_lbl
label variable t13_awareness23 "Aware of AI in 2023"
label variable t13_familiarity_z23                       ///
    "AI familiarity among aware respondents, SD"
label variable t13_aiuse23 "Used AI in 2023"

display as text "2023 AI routing audit:"
tabulate t13_awareness23 `familiarity23', missing
tabulate t13_awareness23 `aiuse23', missing
quietly count if t13_awareness23 == 1 & missing(t13_familiarity_z23)
display as result "Aware respondents missing familiarity: " r(N)
quietly count if t13_awareness23 == 1 & missing(t13_aiuse23)
display as result "Aware respondents missing prior use: " r(N)


*--------------------------------------------------------------------*
* 8. CONSTRUCT INCOME OUTCOMES: 2022 BASELINE AND 2024 OUTCOME
*--------------------------------------------------------------------*

* IHS retains valid zero and negative incomes and reduces right skew.
* Income amounts are scaled to units of 10,000 yuan before transformation.
gen double t13_ihs_indinc22 = asinh(`indincome23'/10000) ///
    if !missing(`indincome23')
gen double t13_ihs_indinc24 = asinh(`indincome25'/10000) ///
    if !missing(`indincome25')

gen double t13_ihs_eqinc22 = asinh(`eqincome23'/10000)  ///
    if !missing(`eqincome23')
gen double t13_ihs_eqinc24 = asinh(`eqincome25'/10000)  ///
    if !missing(`eqincome25')

gen double t13_change_indinc =                          ///
    t13_ihs_indinc24-t13_ihs_indinc22                   ///
    if !missing(t13_ihs_indinc24, t13_ihs_indinc22)
gen double t13_change_eqinc =                           ///
    t13_ihs_eqinc24-t13_ihs_eqinc22                    ///
    if !missing(t13_ihs_eqinc24, t13_ihs_eqinc22)

label variable t13_ihs_indinc22 "IHS individual income, 2022"
label variable t13_ihs_indinc24 "IHS individual income, 2024"
label variable t13_ihs_eqinc22 "IHS equivalized household income, 2022"
label variable t13_ihs_eqinc24 "IHS equivalized household income, 2024"
label variable t13_change_indinc "Change in IHS individual income, 2022-2024"
label variable t13_change_eqinc "Change in IHS equivalized household income, 2022-2024"


*--------------------------------------------------------------------*
* 9. CONSTRUCT AND TRIM ANNUAL WORKING HOURS
*--------------------------------------------------------------------*

gen double t13_hours22 = .
if `components23' {
    replace t13_hours22 =                               ///
        `workmonths23'*`workdays23'*`workhours23'       ///
        if t13_job23 == 1 &                             ///
           inrange(`workmonths23', 1, 12) &             ///
           inrange(`workdays23', 1, 31) &               ///
           `workhours23' > 0 & `workhours23' <= 16
}
else {
    replace t13_hours22 = `worktime23'                  ///
        if t13_job23 == 1 & `worktime23' > 0 &          ///
           `worktime23' <= 4992
}

gen double t13_hours24 = .
if `components25' {
    replace t13_hours24 =                               ///
        `workmonths25'*`workdays25'*`workhours25'       ///
        if t13_job25 == 1 &                             ///
           inrange(`workmonths25', 1, 12) &             ///
           inrange(`workdays25', 1, 31) &               ///
           `workhours25' > 0 & `workhours25' <= 16
}
else {
    replace t13_hours24 = `worktime25'                  ///
        if t13_job25 == 1 & `worktime25' > 0 &          ///
           `worktime25' <= 4992
}

* Trim rather than winsorize: observations below p1 or above p99 are
* excluded independently in each wave among continuously employed workers.
quietly summarize t13_hours22 if `panelvar' == 1 &      ///
    t13_job23 == 1 & t13_job25 == 1, detail
if r(N) == 0 {
    display as error "No valid 2022 working-hour observations were constructed."
    log close
    exit 2000
}
local t13_h22_p1 = r(p1)
local t13_h22_p99 = r(p99)
replace t13_hours22 = . if t13_hours22 < `t13_h22_p1' | ///
    t13_hours22 > `t13_h22_p99'

quietly summarize t13_hours24 if `panelvar' == 1 &      ///
    t13_job23 == 1 & t13_job25 == 1, detail
if r(N) == 0 {
    display as error "No valid 2024 working-hour observations were constructed."
    log close
    exit 2000
}
local t13_h24_p1 = r(p1)
local t13_h24_p99 = r(p99)
replace t13_hours24 = . if t13_hours24 < `t13_h24_p1' | ///
    t13_hours24 > `t13_h24_p99'

gen double t13_hours22_1000 = t13_hours22/1000
gen double t13_hours24_1000 = t13_hours24/1000
gen double t13_change_hours_1000 =                     ///
    t13_hours24_1000-t13_hours22_1000                  ///
    if !missing(t13_hours24_1000, t13_hours22_1000)

label variable t13_hours22_1000 "Annual work hours in 2022, thousands"
label variable t13_hours24_1000 "Annual work hours in 2024, thousands"
label variable t13_change_hours_1000                    ///
    "Change in annual work hours, 2022-2024, thousands"

display as text "Trimmed work-hour distributions:"
summarize t13_hours22 t13_hours24, detail


*--------------------------------------------------------------------*
* 10. DEFINE OUTCOME-SPECIFIC COMMON SAMPLES FOR R1-R4
*--------------------------------------------------------------------*

local common_structural                                  ///
    t13_age23 t13_age23_sq t13_female23                ///
    t13_education23 t13_marriage23 t13_hukoulive23     ///
    t13_city_tier23 t13_region23 t13_ccp23             ///
    t13_city_cluster

local common_devices                                     ///
    t13_phone23 t13_computer23                          ///
    t13_ihs_phonevalue23 t13_ihs_computervalue23       ///
    t13_phonevalue_miss t13_computervalue_miss

local common_ai                                          ///
    t13_awareness23 t13_familiarity_z23 t13_aiuse23

egen byte t13_miss_common = rowmiss(                    ///
    `common_structural' `common_devices' `common_ai')

* Individual income: continuously employed respondents with valid 2022 and
* 2024 reported individual income and a valid 2023 industry.
egen byte t13_miss_ind = rowmiss(                       ///
    t13_ihs_indinc22 t13_ihs_indinc24 t13_ihs_eqinc22  ///
    t13_industry23 t13_ai_weight)
gen byte t13_sample_ind = `panelvar' == 1 &             ///
    !missing(t13_age25) & t13_job23 == 1 &              ///
    t13_job25 == 1 & t13_miss_common == 0 &             ///
    t13_miss_ind == 0

* Household income: linked respondents with valid equivalized
* household income. Employment remains a control because it varies here.
egen byte t13_miss_hh = rowmiss(                        ///
    t13_ihs_eqinc22 t13_ihs_eqinc24 t13_job23          ///
    t13_hh_weight)
gen byte t13_sample_hh = `panelvar' == 1 &              ///
    !missing(t13_age25) & t13_miss_common == 0 &        ///
    t13_miss_hh == 0

* Hours: continuously employed respondents with valid trimmed hours in both
* waves and a valid 2023 industry.
egen byte t13_miss_hours = rowmiss(                     ///
    t13_hours22_1000 t13_hours24_1000 t13_ihs_eqinc22  ///
    t13_industry23 t13_ai_weight)
gen byte t13_sample_hours = `panelvar' == 1 &           ///
    !missing(t13_age25) & t13_job23 == 1 &              ///
    t13_job25 == 1 & t13_miss_common == 0 &             ///
    t13_miss_hours == 0

label variable t13_sample_ind                            ///
    "Common R1-R4 sample: individual income"
label variable t13_sample_hh                             ///
    "Common R1-R4 sample: equivalized household income"
label variable t13_sample_hours                         ///
    "Common R1-R4 sample: annual work hours"

display as text "Common sample sizes:"
quietly count if t13_sample_ind == 1
display as result "Individual income: " r(N)
quietly count if t13_sample_hh == 1
display as result "Equivalized household income: " r(N)
quietly count if t13_sample_hours == 1
display as result "Annual working hours: " r(N)

display as text "Outcome and change-score summaries in analysis samples:"
summarize t13_ihs_indinc22 t13_ihs_indinc24             ///
    t13_change_indinc if t13_sample_ind == 1
summarize t13_ihs_eqinc22 t13_ihs_eqinc24               ///
    t13_change_eqinc if t13_sample_hh == 1
summarize t13_hours22_1000 t13_hours24_1000             ///
    t13_change_hours_1000 if t13_sample_hours == 1


*--------------------------------------------------------------------*
* 11. MODEL SPECIFICATIONS
*--------------------------------------------------------------------*

local demographic23                                     ///
    c.t13_age23 c.t13_age23_sq i.t13_female23          ///
    i.t13_marriage23

local spatial23                                         ///
    i.t13_hukoulive23 ib1.t13_city_tier23              ///
    ib1.t13_region23 i.t13_ccp23

local devices23                                         ///
    i.t13_phone23 i.t13_computer23                     ///
    c.t13_ihs_phonevalue23 c.t13_ihs_computervalue23   ///
    i.t13_phonevalue_miss i.t13_computervalue_miss

local awareness_block                                   ///
    i.t13_awareness23

local engagement_block                                  ///
    c.t13_familiarity_z23 i.t13_aiuse23

* Baseline outcome is always first. Equivalized household income is an
* additional socioeconomic control in the individual-income and hour models.
local structural_ind                                    ///
    c.t13_ihs_indinc22 `demographic23'                  ///
    ib1.t13_education23 c.t13_ihs_eqinc22              ///
    `spatial23' i.t13_industry23

local structural_hh                                     ///
    c.t13_ihs_eqinc22 `demographic23'                   ///
    ib1.t13_education23 i.t13_job23                    ///
    `spatial23'

local structural_hours                                  ///
    c.t13_hours22_1000 `demographic23'                 ///
    ib1.t13_education23 c.t13_ihs_eqinc22              ///
    `spatial23' i.t13_industry23

* Change-score robustness specifications intentionally omit the baseline
* value of the same outcome. Including it would make the exposure coefficient
* algebraically equivalent to the main lagged-outcome specification.
local change_ind                                        ///
    `demographic23' ib1.t13_education23                ///
    c.t13_ihs_eqinc22 `spatial23' i.t13_industry23

local change_hh                                         ///
    `demographic23' ib1.t13_education23 i.t13_job23    ///
    `spatial23'

local change_hours                                      ///
    `demographic23' ib1.t13_education23                ///
    c.t13_ihs_eqinc22 `spatial23' i.t13_industry23

capture program drop t13_add_ai_tests
program define t13_add_ai_tests
    capture quietly testparm i.t13_phone23 i.t13_computer23 ///
        c.t13_ihs_phonevalue23 c.t13_ihs_computervalue23    ///
        i.t13_phonevalue_miss i.t13_computervalue_miss
    if _rc {
        estadd scalar p_devices = .
    }
    else {
        local p = r(p)
        estadd scalar p_devices = `p'
    }

    capture quietly testparm i.t13_awareness23
    if _rc {
        estadd scalar p_awareness = .
    }
    else {
        local p = r(p)
        estadd scalar p_awareness = `p'
    }

    capture quietly testparm c.t13_familiarity_z23 i.t13_aiuse23
    if _rc {
        estadd scalar p_engagement = .
    }
    else {
        local p = r(p)
        estadd scalar p_engagement = `p'
    }
end


*--------------------------------------------------------------------*
* 12. ESTIMATE THE THREE R1-R4 MODEL SEQUENCES
*--------------------------------------------------------------------*

eststo clear

*----------------------------*
* A. Individual income
*----------------------------*

quietly regress t13_ihs_indinc24 `structural_ind'       ///
    if t13_sample_ind == 1 [pweight=t13_ai_weight],     ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_I_R1

quietly regress t13_ihs_indinc24 `structural_ind'       ///
    `devices23' if t13_sample_ind == 1                  ///
    [pweight=t13_ai_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_I_R2

quietly regress t13_ihs_indinc24 `structural_ind'       ///
    `devices23' `awareness_block' if t13_sample_ind == 1 ///
    [pweight=t13_ai_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_I_R3

quietly regress t13_ihs_indinc24 `structural_ind'       ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_ind == 1 [pweight=t13_ai_weight],     ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_I_R4

*----------------------------*
* B. Equivalized household income
*----------------------------*

quietly regress t13_ihs_eqinc24 `structural_hh'         ///
    if t13_sample_hh == 1 [pweight=t13_hh_weight],      ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_H_R1

quietly regress t13_ihs_eqinc24 `structural_hh'         ///
    `devices23' if t13_sample_hh == 1                   ///
    [pweight=t13_hh_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_H_R2

quietly regress t13_ihs_eqinc24 `structural_hh'         ///
    `devices23' `awareness_block' if t13_sample_hh == 1 ///
    [pweight=t13_hh_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_H_R3

quietly regress t13_ihs_eqinc24 `structural_hh'         ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_hh == 1 [pweight=t13_hh_weight],      ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_H_R4

*----------------------------*
* C. Annual working hours
*----------------------------*

quietly regress t13_hours24_1000 `structural_hours'     ///
    if t13_sample_hours == 1 [pweight=t13_ai_weight],   ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_W_R1

quietly regress t13_hours24_1000 `structural_hours'     ///
    `devices23' if t13_sample_hours == 1                ///
    [pweight=t13_ai_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_W_R2

quietly regress t13_hours24_1000 `structural_hours'     ///
    `devices23' `awareness_block' if t13_sample_hours == 1 ///
    [pweight=t13_ai_weight], vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_W_R3

quietly regress t13_hours24_1000 `structural_hours'     ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_hours == 1 [pweight=t13_ai_weight],   ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_W_R4

*----------------------------*
* D. Change-score robustness
*----------------------------*

quietly regress t13_change_indinc `change_ind'          ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_ind == 1 [pweight=t13_ai_weight],     ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_I_D

quietly regress t13_change_eqinc `change_hh'            ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_hh == 1 [pweight=t13_hh_weight],      ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_H_D

quietly regress t13_change_hours_1000 `change_hours'    ///
    `devices23' `awareness_block' `engagement_block'    ///
    if t13_sample_hours == 1 [pweight=t13_ai_weight],   ///
    vce(cluster t13_city_cluster)
t13_add_ai_tests
eststo T13_W_D


*--------------------------------------------------------------------*
* 13. VERIFY IDENTICAL OBSERVATIONS ACROSS R1-R4
*--------------------------------------------------------------------*

foreach outcome in I H W {
    estimates restore T13_`outcome'_R1
    local t13_n_r1 = e(N)
    estimates restore T13_`outcome'_R2
    local t13_n_r2 = e(N)
    estimates restore T13_`outcome'_R3
    local t13_n_r3 = e(N)
    estimates restore T13_`outcome'_R4
    local t13_n_r4 = e(N)

    display as result                                   ///
        "`outcome' N across R1-R4: `t13_n_r1' `t13_n_r2' `t13_n_r3' `t13_n_r4'"

    if `t13_n_r1' != `t13_n_r2' | `t13_n_r1' != `t13_n_r3' | ///
       `t13_n_r1' != `t13_n_r4' {
        display as error "R1-R4 do not use the same observations."
        log close
        exit 459
    }
}

foreach outcome in I H W {
    estimates restore T13_`outcome'_R4
    local t13_n_main = e(N)
    estimates restore T13_`outcome'_D
    local t13_n_change = e(N)
    display as result                                   ///
        "`outcome' N in main/change models: `t13_n_main' `t13_n_change'"
    if `t13_n_main' != `t13_n_change' {
        display as error "The change-score model does not use the main-model sample."
        log close
        exit 459
    }
}


