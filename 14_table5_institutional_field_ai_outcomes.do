    title("Table 5D. Institutional position and perceived consequences of Specialised AI") ///
    addnotes(`table_notes_pai_consequence')


*--------------------------------------------------------------------*
* 11. GENUINE EXCEL WORKBOOK: COEFFICIENTS, TESTS, AND POLICY CODING
*--------------------------------------------------------------------*

global t15_excel "$t15_tables/Table5_industry_policy.xlsx"

* First sheet: auditable industry-policy lookup used by M3.
preserve
    clear
    set obs 14
    gen byte Industry_code = _n
    gen str58 Industry = ""
    replace Industry = "Agriculture, forestry, animal husbandry, fishing" in 1
    replace Industry = "Mining and manufacturing" in 2
    replace Industry = "Construction" in 3
    replace Industry = "Electricity, heat, gas, and water utilities" in 4
    replace Industry = "Wholesale and retail" in 5
    replace Industry = "Transport, storage, and postal services" in 6
    replace Industry = "Accommodation and food services" in 7
    replace Industry = "Information, software, and IT services" in 8
    replace Industry = "Finance" in 9
    replace Industry = "Real estate" in 10
    replace Industry = "Science, education, culture, and health" in 11
    replace Industry = "Resident, repair, and other services" in 12
    replace Industry = "Public administration and social organizations" in 13
    replace Industry = "Other industry" in 14

    gen byte Policy_appearances = .
    replace Policy_appearances = 4 in 1
    replace Policy_appearances = 6 in 2
    replace Policy_appearances = 2 in 3
    replace Policy_appearances = 2 in 4
    replace Policy_appearances = 2 in 5
    replace Policy_appearances = 3 in 6
    replace Policy_appearances = 1 in 7
    replace Policy_appearances = 2 in 9
    replace Policy_appearances = 0 in 10
    replace Policy_appearances = 8 in 11
    replace Policy_appearances = 3 in 12
    replace Policy_appearances = 4 in 13
    replace Policy_appearances = 0 in 14

    gen str38 Policy_category = ""
    replace Policy_category = "No pre-survey policy promotion" if ///
        Policy_appearances == 0
    replace Policy_category = "Policy promoted: 1-2 appearances" if ///
        inrange(Policy_appearances, 1, 2)
    replace Policy_category = "Key policy promoted: 3+ appearances" if ///
        Policy_appearances >= 3 & !missing(Policy_appearances)
    replace Policy_category = "Key promoted: AI-producing core" in 8

    gen byte Model_policy_code = .
    replace Model_policy_code = 0 if Policy_appearances == 0
    replace Model_policy_code = 1 if inrange(Policy_appearances, 1, 2)
    replace Model_policy_code = 2 if Policy_appearances >= 3 & ///
        !missing(Policy_appearances)
    replace Model_policy_code = 2 in 8

    gen str46 Model_policy_category = ""
    replace Model_policy_category = "No pre-survey policy promotion" if ///
        Model_policy_code == 0
    replace Model_policy_category = "Policy promoted: 1-2 appearances" if ///
        Model_policy_code == 1
    replace Model_policy_category =                       ///
        "Key promoted: 3+ appearances or AI core" if    ///
        Model_policy_code == 2

    gen str60 Coding_cutoff = "Official promotion documents through 2025-05-31"
    export excel using "$t15_excel", sheet("Policy coding") ///
        firstrow(variables) replace
restore

* Map focal coefficient identifiers to publication-readable labels.
preserve
    use `t15_focal_results', clear
    gen int Row_order = .
    gen str58 Predictor = Coef

    replace Row_order = 1 if Coef == "2.t15_empstudent"
    replace Predictor = "Employed and in school" if Row_order == 1
    replace Row_order = 2 if Coef == "3.t15_empstudent"
    replace Predictor = "In school, not employed" if Row_order == 2
    replace Row_order = 3 if Coef == "4.t15_empstudent"
    replace Predictor = "Neither employed nor in school" if Row_order == 3

    forvalues j = 1/15 {
        if `j' != 2 {
            replace Row_order = 30+`j' if                ///
                Coef == "`j'.t15_industry_detail"
        }
    }
    replace Predictor = "Agriculture/forestry/animal husbandry/fishing" if Coef == "1.t15_industry_detail"
    replace Predictor = "Construction" if Coef == "3.t15_industry_detail"
    replace Predictor = "Electricity/heat/gas/water utilities" if Coef == "4.t15_industry_detail"
    replace Predictor = "Wholesale and retail" if Coef == "5.t15_industry_detail"
    replace Predictor = "Transport/storage/postal services" if Coef == "6.t15_industry_detail"
    replace Predictor = "Accommodation and food services" if Coef == "7.t15_industry_detail"
    replace Predictor = "Information/software/IT services" if Coef == "8.t15_industry_detail"
    replace Predictor = "Finance" if Coef == "9.t15_industry_detail"
    replace Predictor = "Real estate" if Coef == "10.t15_industry_detail"
    replace Predictor = "Science/education/culture/health" if Coef == "11.t15_industry_detail"
    replace Predictor = "Resident/repair/other services" if Coef == "12.t15_industry_detail"
    replace Predictor = "Public administration/social organizations" if Coef == "13.t15_industry_detail"
    replace Predictor = "Other industry" if Coef == "14.t15_industry_detail"
    replace Predictor = "Industry unavailable" if Coef == "15.t15_industry_detail"

    replace Row_order = 61 if Coef == "1.t15_policy_intensity"
    replace Predictor = "Policy promoted: 1-2 appearances" if Row_order == 61
    replace Row_order = 62 if Coef == "2.t15_policy_intensity"
    replace Predictor = "Key promoted: 3+ appearances or AI core" if Row_order == 62

    replace Row_order = 71 if Coef == "2.t15_industry_broad"
    replace Predictor = "Consumer, logistics, and other services" if Row_order == 71
    replace Row_order = 72 if Coef == "3.t15_industry_broad"
    replace Predictor = "Information and knowledge-intensive market services" if Row_order == 72
    replace Row_order = 73 if Coef == "4.t15_industry_broad"
    replace Predictor = "Education, health, and public services" if Row_order == 73
    gen byte Outcome_order = .
    replace Outcome_order = 1 if Outcome == "use"
    replace Outcome_order = 2 if Outcome == "breadth"
    replace Outcome_order = 3 if Outcome == "time"
    replace Outcome_order = 4 if Outcome == "aug"
    replace Outcome_order = 5 if Outcome == "pressure"
    format Odds_ratio Log_SE P_value CI_low CI_high %9.3f
    save `t15_focal_results', replace
restore

foreach AI in GAI PAI {
    local AI_sheet "Generative AI"
    if "`AI'" == "PAI" local AI_sheet "Specialised AI"
    preserve
        use `t15_focal_results', clear
        keep if AI == "`AI'" & inlist(Outcome, "use", "breadth", "time")
        drop AI
        reshape wide Odds_ratio Log_SE P_value CI_low CI_high, ///
            i(Outcome Outcome_order Row_order Coef Predictor) j(Model)
        sort Outcome_order Row_order
        order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
            CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
            CI_low2 CI_high2 Odds_ratio3 Log_SE3 P_value3         ///
            CI_low3 CI_high3
        export excel using "$t15_excel",                  ///
            sheet("`AI_sheet' incorporation") firstrow(variables) sheetreplace
    restore

    preserve
        use `t15_focal_results', clear
        keep if AI == "`AI'" & inlist(Outcome, "aug", "pressure")
        drop AI
        reshape wide Odds_ratio Log_SE P_value CI_low CI_high, ///
            i(Outcome Outcome_order Row_order Coef Predictor) j(Model)
        sort Outcome_order Row_order
        if "`AI'" == "GAI" {
            order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
                CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
                CI_low2 CI_high2 Odds_ratio3 Log_SE3 P_value3         ///
                CI_low3 CI_high3
        }
        else {
            order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
                CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
                CI_low2 CI_high2
        }
        export excel using "$t15_excel",                  ///
            sheet("`AI_sheet' consequences") firstrow(variables) sheetreplace
    restore
}

preserve
    use `t15_model_tests', clear
    label variable P_position "Joint p: employment/student position"
    label variable P_industry "Joint p: industry field"
    label variable P_policy "Joint p: policy category"
    label variable P_key_vs_promoted "p: key promoted = promoted"
    format P_position P_industry P_policy P_key_vs_promoted %9.4f
    export excel using "$t15_excel", sheet("Model tests") ///
        firstrow(varlabels) sheetreplace
restore


