version 16.0
set more off

/*
    TABLE 5: INSTITUTIONAL FIELD, AI INCORPORATION, AND CONSEQUENCES

    Run this file with the final person-level WIDE dataset already open.
    It does not load, merge, append, reshape, or overwrite the data.

    For each Generative AI and Specialised AI outcome, the file estimates
    three models:
      M1. Employment/student position + controls
      M2. M1 + detailed industry
      M3. Employment/student position + policy intensity
          + controls; detailed industry is replaced, not retained.

    Main incorporation outcomes are breadth and daily time. Binary Generative
    AI use is excluded from the main models because adoption is nearly
    universal and causes complete prediction. Specialised AI use is retained.
    Consequence outcomes are productive augmentation and adaptive pressure.

    Policy intensity is based on distinct central policy documents issued
    before the June 2025 fieldwork. The raw count and its classification
    are constructed explicitly below. The AI-producing information industry
    is included in the theoretically adjacent "key promoted" category even
    when policy documents frame it as the technology-producing core rather
    than as a recipient industry. Genuinely unavailable industry is treated as missing rather
    than as a substantive policy-exposure category. Industry code 14
    remains "Other industry" and is never treated as missing.

    The analysis retains person records with valid AI outcomes and covariates.
*/


*--------------------------------------------------------------------*
* 0. OUTPUT, LOG, AND CLEANUP
*--------------------------------------------------------------------*

if `"$project_root"' == "" global project_root "."

* Household weights are the default because the AI module comes from the
* household questionnaire. Change to "individual" only if the AI module
* independently sampled persons.
local ai_analysis_weight "household"

global t15_results "$project_root/results/main_tables"
global t15_tables  "$t15_results/tables"
global t15_logs    "$t15_results/logs"

capture mkdir "$project_root/results"
capture mkdir "$t15_results"
capture mkdir "$t15_tables"
capture mkdir "$t15_logs"

capture log close _all
log using "$t15_logs/14_table5_institutional_field_ai_outcomes.log", ///
    text replace

* Drop only variables generated by an earlier run of this file.
capture drop t15_*

capture which esttab
if _rc {
    display as error "The estout package is required. Install it once with:"
    display as error "ssc install estout"
    log close
    exit 199
}


*--------------------------------------------------------------------*
* 1. LOCATE DEMOGRAPHIC AND INSTITUTIONAL-FIELD VARIABLES
*--------------------------------------------------------------------*

capture confirm variable hhid
if _rc {
    display as error "Required household identifier hhid is absent."
    log close
    exit 111
}

local agevar ""
foreach candidate in age_w25 age2025 {
    capture confirm variable `candidate'
    if !_rc & `"`agevar'"' == "" local agevar `candidate'
}

local birthyearvar ""
foreach candidate in birthyear_w25 birthy_w25 birthyear2025 {
    capture confirm variable `candidate'
    if !_rc & `"`birthyearvar'"' == "" local birthyearvar `candidate'
}
if `"`agevar'"' == "" & `"`birthyearvar'"' == "" {
    display as error "Neither 2025 age nor 2025 birth year was found."
    log close
    exit 111
}

local sexvar ""
foreach candidate in sex_w25 sex2025 {
    capture confirm variable `candidate'
    if !_rc & `"`sexvar'"' == "" local sexvar `candidate'
}

local educationvar ""
foreach candidate in education_w25 edulev_w25 education2025 {
    capture confirm variable `candidate'
    if !_rc & `"`educationvar'"' == "" local educationvar `candidate'
}

local marriagevar ""
foreach candidate in marriage_w25 marriage2025 {
    capture confirm variable `candidate'
    if !_rc & `"`marriagevar'"' == "" local marriagevar `candidate'
}

local eqincomevar ""
foreach candidate in eq_income_w25 eq_income_alt_w25    ///
                         eqincome_w25 eqincome1_w25      ///
                         equivalized_income_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`eqincomevar'"' == "" local eqincomevar `candidate'
}

local jobvar ""
foreach candidate in havejob_w25 havejob2025 {
    capture confirm variable `candidate'
    if !_rc & `"`jobvar'"' == "" local jobvar `candidate'
}

local schoolvar ""
foreach candidate in inschool_w25 inedu_w25 inedu2025 still_school_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`schoolvar'"' == "" local schoolvar `candidate'
}

local industryvar ""
foreach candidate in industry_w25 industry2025 {
    capture confirm variable `candidate'
    if !_rc & `"`industryvar'"' == "" local industryvar `candidate'
}

local hukouvar ""
foreach candidate in hukouknlv_w25 hukounlive_w25 hukouknlv1_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`hukouvar'"' == "" local hukouvar `candidate'
}

local citytiervar ""
foreach candidate in city_level_w25 citylevel_w25 city_level2025 {
    capture confirm variable `candidate'
    if !_rc & `"`citytiervar'"' == "" local citytiervar `candidate'
}

local regionvar ""
foreach candidate in region_w25 region2025 {
    capture confirm variable `candidate'
    if !_rc & `"`regionvar'"' == "" local regionvar `candidate'
}

local partyvar ""
foreach candidate in party_w25 partym_w25 partym2025 party_member_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`partyvar'"' == "" local partyvar `candidate'
}

local required_aliases sexvar educationvar marriagevar eqincomevar ///
                       jobvar schoolvar industryvar                 ///
                       hukouvar                                    ///
                       citytiervar regionvar partyvar
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 2. LOCATE THE GAI AND PAI OUTCOMES
*--------------------------------------------------------------------*

local gaiuse ""
foreach candidate in gai_use_w25 gai_use_raw_w25 gai_use2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaiuse'"' == "" local gaiuse `candidate'
}

local gaibreadth ""
foreach candidate in gai_breadth_w25 gai_tool_cat_w25 gai_breadth2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaibreadth'"' == "" local gaibreadth `candidate'
}

local gaitime ""
foreach candidate in gai_time_w25 useAI_time_w25 T1007a_w25 t1007a_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`gaitime'"' == "" local gaitime `candidate'
}

local gaiaug ""
foreach candidate in gai_augmentation_w25 gai_augmentation2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaiaug'"' == "" local gaiaug `candidate'
}

local gaipressure ""
foreach candidate in gai_pressure_w25 gai_pressure2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaipressure'"' == "" local gaipressure `candidate'
}

local paiuse ""
foreach candidate in pai_use_w25 pai_use_raw_w25 pai_use2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paiuse'"' == "" local paiuse `candidate'
}

local paibreadth ""
foreach candidate in pai_breadth_w25 pai_tool_cat_w25 pai_breadth2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paibreadth'"' == "" local paibreadth `candidate'
}

local paitime ""
foreach candidate in pai_time_w25 usePAI_time_w25 T1007b_w25 t1007b_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`paitime'"' == "" local paitime `candidate'
}

local paiaug ""
foreach candidate in pai_augmentation_w25 pai_augmentation2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paiaug'"' == "" local paiaug `candidate'
}

local paipressure ""
foreach candidate in pai_pressure_w25 pai_pressure2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paipressure'"' == "" local paipressure `candidate'
}

local required_aliases gaiuse gaibreadth gaitime gaiaug gaipressure ///
                       paiuse paibreadth paitime paiaug paipressure
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required AI-outcome alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 3. LOCATE WEIGHTS AND GEOGRAPHIC CLUSTERS
*--------------------------------------------------------------------*

local householdweightvar ""
foreach candidate in household_weight_w25 weight_hh_w25 wgt_hh_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`householdweightvar'"' == "" {
        local householdweightvar `candidate'
    }
}

local individualweightvar ""
foreach candidate in individual_weight_w25 weight_ind_w25 wgt_ind_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`individualweightvar'"' == "" {
        local individualweightvar `candidate'
    }
}

local weightvar ""
if `"`ai_analysis_weight'"' == "household" {
    local weightvar `householdweightvar'
}
else if `"`ai_analysis_weight'"' == "individual" {
    local weightvar `individualweightvar'
}
else {
    display as error "ai_analysis_weight must be household or individual."
    log close
    exit 198
}

local provincevar ""
foreach candidate in province_w25 prov_code_w25 province_w23 prov_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`provincevar'"' == "" local provincevar `candidate'
}

local cityvar ""
foreach candidate in city_w25 city_code_w25 city_w23 city_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`cityvar'"' == "" local cityvar `candidate'
}

local required_aliases weightvar provincevar cityvar
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required survey-design alias `alias' was not found."
        log close
        exit 111
    }
}

display as text "Variables selected:"
display as result "Employment/school/industry: `jobvar' / `schoolvar' / `industryvar'"
display as result "GAI outcomes: `gaiuse' `gaibreadth' `gaitime' `gaiaug' `gaipressure'"
display as result "PAI outcomes: `paiuse' `paibreadth' `paitime' `paiaug' `paipressure'"
display as result "Analysis weight (`ai_analysis_weight'): `weightvar'"


*--------------------------------------------------------------------*
* 4. CONSTRUCT DEMOGRAPHIC AND GEOGRAPHIC CONTROLS
*--------------------------------------------------------------------*

gen double t15_age = .
if `"`agevar'"' != "" {
    replace t15_age = `agevar' if inrange(`agevar', 16, 65)
}
else {
    replace t15_age = 2025-`birthyearvar'               ///
        if inrange(2025-`birthyearvar', 16, 65)
}
gen double t15_age_sq = t15_age^2 if !missing(t15_age)

* Constructed variables accept only substantive codes. Stata's extended
* missings (.a-.z, including .d and .n) and survey nonresponse codes such
* as 7777 therefore remain missing without stopping the do-file.
gen byte t15_female = `sexvar' == 2 if inlist(`sexvar', 1, 2)
label define t15_female_lbl 0 "Male" 1 "Female", replace
label values t15_female t15_female_lbl

gen byte t15_education = .
replace t15_education = 1 if inrange(`educationvar', 0, 2)
replace t15_education = 2 if inlist(`educationvar', 3, 4)
replace t15_education = 3 if inrange(`educationvar', 5, 7)
label define t15_education_lbl                          ///
    1 "Compulsory education or less"                   ///
    2 "Upper-secondary or vocational"                 ///
    3 "Tertiary education", replace
label values t15_education t15_education_lbl

gen double t15_eqincome_10k = `eqincomevar'/10000       ///
    if !missing(`eqincomevar')
gen double t15_ihs_eqincome = asinh(t15_eqincome_10k)
label variable t15_ihs_eqincome                         ///
    "IHS equivalized household income, 2024"

gen byte t15_marriage = `marriagevar' if               ///
    inrange(`marriagevar', 1, 6)
gen byte t15_hukoulive = `hukouvar' if                 ///
    inrange(`hukouvar', 1, 4)
gen byte t15_city_tier = `citytiervar' if              ///
    inrange(`citytiervar', 1, 3)
gen byte t15_region = `regionvar' if                   ///
    inrange(`regionvar', 1, 4)

label define t15_city_tier_en                           ///
    1 "First-tier and new first-tier cities"           ///
    2 "Second-tier cities"                             ///
    3 "Third-tier cities and below", replace
label values t15_city_tier t15_city_tier_en

label define t15_region_en                              ///
    1 "East"                                           ///
    2 "Central"                                        ///
    3 "West"                                           ///
    4 "Northeast", replace
label values t15_region t15_region_en

gen byte t15_ccp = .
replace t15_ccp = 1 if `partyvar' == 1
replace t15_ccp = 0 if inlist(`partyvar', 0, 2, 3, 4)
label define t15_ccp_lbl 0 "Not a CCP member" 1 "CCP member", replace
label values t15_ccp t15_ccp_lbl

gen double t15_weight = `weightvar' if                 ///
    !missing(`weightvar') & `weightvar' > 0 &          ///
    !inlist(`weightvar', 7777, 7788, 9999)

egen int t15_province = group(`provincevar')
egen long t15_city_cluster = group(`provincevar' `cityvar')


*--------------------------------------------------------------------*
* 5. EMPLOYMENT-STUDENT POSITION AND DETAILED INDUSTRY
*--------------------------------------------------------------------*

* No validation error is issued for nonresponse codes. Only exact 0/1
* values enter employment/student status. Detailed industry accepts 1-14;
* all other values, including 7777, become missing because "Other industry"
* has already been harmonized to code 14.

* Employment/student status is kept separate from industry. This retains
* students and non-employed respondents in all three models.
gen byte t15_empstudent = .
replace t15_empstudent = 1 if `jobvar' == 1 & `schoolvar' == 0
replace t15_empstudent = 2 if `jobvar' == 1 & `schoolvar' == 1
replace t15_empstudent = 3 if `jobvar' == 0 & `schoolvar' == 1
replace t15_empstudent = 4 if `jobvar' == 0 & `schoolvar' == 0
label define t15_empstudent_lbl                          ///
    1 "Employed, not in school"                        ///
    2 "Employed and in school"                         ///
    3 "In school, not employed"                        ///
    4 "Neither employed nor in school", replace
label values t15_empstudent t15_empstudent_lbl

* Mining/manufacturing (2) is the detailed-industry reference. As above,
* non-employed respondents receive only the neutral base value and are
* distinguished by t15_empstudent. Industry 14 remains "Other industry."
gen byte t15_industry_detail = `industryvar' if `jobvar' == 1 & ///
    inrange(`industryvar', 1, 14)
replace t15_industry_detail = 15 if `jobvar' == 1 &     ///
    missing(`industryvar')
replace t15_industry_detail = 2 if `jobvar' == 0
label define t15_industry_lbl                            ///
    1 "Agriculture, forestry, animal husbandry, fishing" ///
    2 "Mining and manufacturing"                       ///
    3 "Construction"                                   ///
    4 "Electricity, heat, gas, and water utilities"    ///
    5 "Wholesale and retail"                           ///
    6 "Transport, storage, and postal services"        ///
    7 "Accommodation and food services"                ///
    8 "Information, software, and IT services"         ///
    9 "Finance"                                        ///
    10 "Real estate"                                   ///
    11 "Science, education, culture, and health"       ///
    12 "Resident, repair, and other services"          ///
    13 "Public administration and social organizations" ///
    14 "Other industry"                                ///
    15 "Industry unavailable", replace
label values t15_industry_detail t15_industry_lbl


*--------------------------------------------------------------------*
* 6. PRE-SURVEY POLICY-APPEARANCE COUNT AND INTENSITY
*--------------------------------------------------------------------*

/*
    Coding unit: one distinct central-government or ministry policy
    document explicitly promoting or demonstrating AI application in a
    CHFS industry. Each document contributes at most one appearance to an
    industry, regardless of repeated words in the document.

    Cutoff: 31 May 2025, immediately before the June 2025 fieldwork.
    Excluded: interpretations/news, duplicate explanations, governance-only
    documents, and every document issued after the cutoff.

    The strict corpus yields the following recipient-industry counts:
       1=4, 2=6, 3=2, 4=2, 5=2, 6=3, 7=1,
       9=2, 10=0, 11=8, 12=3, 13=4, 14=0.
    Industry 8 is separated as the AI-producing core rather than assigned
    a recipient-industry exposure count.
*/

gen byte t15_policy_count = .
replace t15_policy_count = 4 if `industryvar' == 1
replace t15_policy_count = 6 if `industryvar' == 2
replace t15_policy_count = 2 if `industryvar' == 3
replace t15_policy_count = 2 if `industryvar' == 4
replace t15_policy_count = 2 if `industryvar' == 5
replace t15_policy_count = 3 if `industryvar' == 6
replace t15_policy_count = 1 if `industryvar' == 7
replace t15_policy_count = 2 if `industryvar' == 9
replace t15_policy_count = 0 if `industryvar' == 10
replace t15_policy_count = 8 if `industryvar' == 11
replace t15_policy_count = 3 if `industryvar' == 12
replace t15_policy_count = 4 if `industryvar' == 13
replace t15_policy_count = 0 if `industryvar' == 14
label variable t15_policy_count                         ///
    "Pre-survey central AI-promotion policy appearances"

* Policy intensity is an industry-level categorical measure among workers.
* Non-employed respondents take the neutral reference value zero, while
* t15_empstudent identifies their actual labor-force/student position.
* The AI-producing information industry is grouped with key-promoted
* recipient industries. This retains the ordered theoretical distinction
* (not promoted / promoted / key promoted) without estimating a very small
* stand-alone category against a nearly universal GAI-use outcome.
* Employed respondents whose industry is genuinely unavailable remain
* missing and are therefore excluded from the common M1-M3 sample.
gen byte t15_policy_intensity = .
replace t15_policy_intensity = 0 if `jobvar' == 0
replace t15_policy_intensity = 0 if `jobvar' == 1 &     ///
    inlist(`industryvar', 10, 14)
replace t15_policy_intensity = 1 if `jobvar' == 1 &     ///
    inlist(`industryvar', 3, 4, 5, 7, 9)
replace t15_policy_intensity = 2 if `jobvar' == 1 &     ///
    inlist(`industryvar', 1, 2, 6, 8, 11, 12, 13)
label define t15_policy_lbl                              ///
    0 "No pre-survey policy promotion"                 ///
    1 "Policy promoted: 1-2 appearances"               ///
    2 "Key promoted (3+ appearances or AI core)", replace
label values t15_policy_intensity t15_policy_lbl

* The specialised-AI consequence sample is much smaller than the main
* incorporation samples. Four broad institutional fields replace fourteen
* detailed industries in that analysis to avoid quasi-separation.
gen byte t15_industry_broad = 1 if `jobvar' == 0
replace t15_industry_broad = 1 if `jobvar' == 1 &       ///
    inlist(`industryvar', 1, 2, 3, 4)
replace t15_industry_broad = 2 if `jobvar' == 1 &       ///
    inlist(`industryvar', 5, 6, 7, 10, 12, 14)
replace t15_industry_broad = 3 if `jobvar' == 1 &       ///
    inlist(`industryvar', 8, 9)
replace t15_industry_broad = 4 if `jobvar' == 1 &       ///
    inlist(`industryvar', 11, 13)
label define t15_industry_broad_lbl                     ///
    1 "Production and infrastructure"                 ///
    2 "Consumer, logistics, and other services"       ///
    3 "Information and knowledge-intensive market services" ///
    4 "Education, health, and public services", replace
label values t15_industry_broad t15_industry_broad_lbl

gen byte t15_policy_any = 0 if t15_policy_intensity == 0
replace t15_policy_any = 1 if inlist(t15_policy_intensity, 1, 2)
label define t15_policy_any_lbl                         ///
    0 "No pre-survey policy promotion"                ///
    1 "Any pre-survey policy promotion", replace
label values t15_policy_any t15_policy_any_lbl

display as text "Employment/student position:"
tabulate t15_empstudent if !missing(t15_age), missing
display as text "Detailed industry:"
tabulate t15_industry_detail if !missing(t15_age), missing
display as text "Policy intensity:"
tabulate t15_policy_intensity if !missing(t15_age), missing
display as text "Broad industry fields used for Specialised AI consequences:"
tabulate t15_industry_broad if !missing(t15_age), missing


*--------------------------------------------------------------------*
* 7. CONSTRUCT AI INCORPORATION AND PERCEIVED-CONSEQUENCE OUTCOMES
*--------------------------------------------------------------------*

gen byte t15_gai_use = `gaiuse' if inlist(`gaiuse', 0, 1)
gen byte t15_pai_use = `paiuse' if inlist(`paiuse', 0, 1)

* Confirmed nonusers receive zero; genuine missing responses remain missing.
gen byte t15_gai_breadth = 0 if t15_gai_use == 0
replace t15_gai_breadth = `gaibreadth' if t15_gai_use == 1 & ///
    inrange(`gaibreadth', 1, 3)
gen byte t15_pai_breadth = 0 if t15_pai_use == 0
replace t15_pai_breadth = `paibreadth' if t15_pai_use == 1 & ///
    inrange(`paibreadth', 1, 3)

label define t15_breadth_lbl                             ///
    0 "Nonuser" 1 "One AI tool"                       ///
    2 "Two to five AI tools" 3 "More than five AI tools", replace
label values t15_gai_breadth t15_pai_breadth t15_breadth_lbl

* Time may contain questionnaire categories 1-6 or approximate hours.
gen byte t15_gai_time = 0 if t15_gai_use == 0
quietly count if t15_gai_use == 1 & !missing(`gaitime') & ///
    !inlist(`gaitime', 7777, 7788, 9999)
local t15_gai_time_n = r(N)
quietly count if t15_gai_use == 1 & !missing(`gaitime') & ///
    !inlist(`gaitime', 7777, 7788, 9999) &              ///
    !inlist(`gaitime', 1, 2, 3, 4, 5, 6)
local t15_gai_time_noncode = r(N)
if `t15_gai_time_n' == 0 {
    display as error "No valid GAI-time responses among confirmed users."
    log close
    exit 2000
}
if `t15_gai_time_noncode' == 0 {
    replace t15_gai_time = 1 if t15_gai_use == 1 & `gaitime' == 1
    replace t15_gai_time = 2 if t15_gai_use == 1 & `gaitime' == 2
    replace t15_gai_time = 3 if t15_gai_use == 1 &       ///
        inrange(`gaitime', 3, 6)
}
else {
    replace t15_gai_time = 1 if t15_gai_use == 1 &       ///
        `gaitime' > 0 & `gaitime' <= .5
    replace t15_gai_time = 2 if t15_gai_use == 1 &       ///
        `gaitime' > .5 & `gaitime' <= 1
    replace t15_gai_time = 3 if t15_gai_use == 1 &       ///
        `gaitime' > 1 & `gaitime' <= 24
}

gen byte t15_pai_time = 0 if t15_pai_use == 0
quietly count if t15_pai_use == 1 & !missing(`paitime') & ///
    !inlist(`paitime', 7777, 7788, 9999)
local t15_pai_time_n = r(N)
quietly count if t15_pai_use == 1 & !missing(`paitime') & ///
    !inlist(`paitime', 7777, 7788, 9999) &              ///
    !inlist(`paitime', 1, 2, 3, 4, 5, 6)
local t15_pai_time_noncode = r(N)
if `t15_pai_time_n' == 0 {
    display as error "No valid PAI-time responses among confirmed users."
    log close
    exit 2000
}
if `t15_pai_time_noncode' == 0 {
    replace t15_pai_time = 1 if t15_pai_use == 1 & `paitime' == 1
    replace t15_pai_time = 2 if t15_pai_use == 1 & `paitime' == 2
    replace t15_pai_time = 3 if t15_pai_use == 1 &       ///
        inrange(`paitime', 3, 6)
}
else {
    replace t15_pai_time = 1 if t15_pai_use == 1 &       ///
        `paitime' > 0 & `paitime' <= .5
    replace t15_pai_time = 2 if t15_pai_use == 1 &       ///
        `paitime' > .5 & `paitime' <= 1
    replace t15_pai_time = 3 if t15_pai_use == 1 &       ///
        `paitime' > 1 & `paitime' <= 24
}

label define t15_time_lbl                                ///
    0 "Nonuser" 1 "Up to 0.5 hour"                    ///
    2 "0.5-1 hour" 3 "More than 1 hour", replace
label values t15_gai_time t15_pai_time t15_time_lbl

* Consequences are estimated only among confirmed corresponding AI users.
gen byte t15_gai_aug = `gaiaug' if t15_gai_use == 1 &   ///
    inlist(`gaiaug', 0, 1)
gen byte t15_gai_pressure = `gaipressure' if t15_gai_use == 1 & ///
    inlist(`gaipressure', 0, 1)
gen byte t15_pai_aug = `paiaug' if t15_pai_use == 1 &   ///
    inlist(`paiaug', 0, 1)
gen byte t15_pai_pressure = `paipressure' if t15_pai_use == 1 & ///
    inlist(`paipressure', 0, 1)

label define t15_yesno_lbl 0 "No" 1 "Yes", replace
label values t15_gai_use t15_pai_use                    ///
    t15_gai_aug t15_gai_pressure                        ///
    t15_pai_aug t15_pai_pressure t15_yesno_lbl

label variable t15_gai_use "Used general-purpose AI"
label variable t15_gai_breadth "Breadth of general-purpose AI use"
label variable t15_gai_time "Daily general-purpose AI-use time"
label variable t15_gai_aug "Productive augmentation from GAI"
label variable t15_gai_pressure "Adaptive pressure from GAI"
label variable t15_pai_use "Used professional AI"
label variable t15_pai_breadth "Breadth of professional AI use"
label variable t15_pai_time "Daily professional AI-use time"
label variable t15_pai_aug "Productive augmentation from PAI"
label variable t15_pai_pressure "Adaptive pressure from PAI"

display as text "AI outcome distributions:"
foreach outcome in gai_use gai_breadth gai_time gai_aug gai_pressure ///
                   pai_use pai_breadth pai_time pai_aug pai_pressure {
    tabulate t15_`outcome', missing
}

*--------------------------------------------------------------------*
* 8. COMMON OUTCOME-SPECIFIC SAMPLES
*--------------------------------------------------------------------*

local sample_vars                                        ///
    t15_age t15_age_sq t15_female t15_education         ///
    t15_ihs_eqincome t15_marriage t15_hukoulive         ///
    t15_city_tier t15_region t15_ccp t15_empstudent     ///
    t15_industry_detail t15_policy_intensity            ///
    t15_weight t15_city_cluster

egen byte t15_miss_base = rowmiss(`sample_vars')
gen byte t15_base = t15_miss_base == 0

foreach outcome in gai_use gai_breadth gai_time gai_aug gai_pressure ///
                   pai_use pai_breadth pai_time pai_aug pai_pressure {
    gen byte t15_sample_`outcome' = t15_base == 1 &     ///
        !missing(t15_`outcome')
    quietly count if t15_sample_`outcome' == 1
    display as result "Sample `outcome': " r(N)

}

display as text "Sparse-cell audit for Specialised AI consequences:"
foreach outcome in aug pressure {
    tabulate t15_industry_broad t15_pai_`outcome'       ///
        if t15_sample_pai_`outcome' == 1, missing
    tabulate t15_policy_any t15_pai_`outcome'           ///
        if t15_sample_pai_`outcome' == 1, missing
}


*--------------------------------------------------------------------*
* 9. MODEL SEQUENCE AND ESTIMATION
*--------------------------------------------------------------------*

local common                                             ///
    ib1.t15_empstudent                                  ///
    c.t15_age c.t15_age_sq i.t15_female                ///
    ib1.t15_education c.t15_ihs_eqincome               ///
    i.t15_marriage i.t15_hukoulive                     ///
    ib1.t15_city_tier ib1.t15_region i.t15_ccp

local model1 `common'
local model2 `common' ib2.t15_industry_detail
local model3 `common' ib0.t15_policy_intensity
local model2_pai_consequence `common' ib1.t15_industry_broad

local coef_common                                        ///
    2.t15_empstudent 3.t15_empstudent 4.t15_empstudent
local coef_industry                                      ///
    1.t15_industry_detail 3.t15_industry_detail        ///
    4.t15_industry_detail 5.t15_industry_detail        ///
    6.t15_industry_detail 7.t15_industry_detail        ///
    8.t15_industry_detail 9.t15_industry_detail        ///
    10.t15_industry_detail 11.t15_industry_detail      ///
    12.t15_industry_detail 13.t15_industry_detail      ///
    14.t15_industry_detail
local coef_policy                                        ///
    1.t15_policy_intensity 2.t15_policy_intensity
local coef_industry_broad                               ///
    2.t15_industry_broad 3.t15_industry_broad          ///
    4.t15_industry_broad

tempfile t15_focal_results t15_model_tests
tempname t15_coefpost t15_testpost
postfile `t15_coefpost' str3 AI str12 Outcome byte Model ///
    str40 Coef double Odds_ratio Log_SE P_value         ///
    CI_low CI_high using `t15_focal_results', replace
postfile `t15_testpost' str3 AI str12 Outcome byte Model ///
    long Observations City_clusters double              ///
    P_position P_industry P_policy P_key_vs_promoted   ///
    using `t15_model_tests', replace

eststo clear

foreach ai in gai pai {
    if "`ai'" == "gai" local AI "GAI"
    if "`ai'" == "pai" local AI "PAI"

    local outcome_list "breadth time aug pressure"
    if "`ai'" == "pai" local outcome_list "use breadth time aug pressure"

    foreach outcome of local outcome_list {
        local estimator "logit"
        if "`outcome'" == "breadth" local estimator "ologit"
        if "`outcome'" == "time"    local estimator "ologit"

        local model_numbers "1 2 3"
        if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
            local model_numbers "1 2"
        }

        foreach m of local model_numbers {
            local rhs "`model1'"
            if `m' == 2 local rhs "`model2'"
            if `m' == 3 local rhs "`model3'"
            if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                if `m' == 2 local rhs "`model2_pai_consequence'"
            }

            display as text "Estimating `AI' `outcome', M`m' (`estimator')"
            capture quietly `estimator' t15_`ai'_`outcome' `rhs' ///
                if t15_sample_`ai'_`outcome' == 1       ///
                [pweight=t15_weight],                   ///
                vce(cluster t15_city_cluster) difficult iterate(500)

            local fit_rc = _rc
            if `fit_rc' {
                display as error "Model failed: `AI' `outcome', M`m'; return code `fit_rc'."
                display as error "Outcome-by-policy counts are shown below to diagnose sparse or separated cells."
                if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                    tabulate t15_industry_broad         ///
                        t15_`ai'_`outcome'              ///
                        if t15_sample_`ai'_`outcome' == 1, missing
                    tabulate t15_policy_any             ///
                        t15_`ai'_`outcome'              ///
                        if t15_sample_`ai'_`outcome' == 1, missing
                }
                else {
                    tabulate t15_policy_intensity       ///
                        t15_`ai'_`outcome'              ///
                        if t15_sample_`ai'_`outcome' == 1, missing
                }
                capture postclose `t15_coefpost'
                capture postclose `t15_testpost'
                log close
                exit `fit_rc'
            }

            local OUT = upper("`outcome'")
            local estname T15_`AI'_`OUT'_M`m'
            eststo `estname'

            local p_position = .
            capture quietly testparm i.t15_empstudent
            if !_rc local p_position = r(p)
            local p_industry = .
            local p_policy = .
            local p_key = .

            if `m' == 2 {
                if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                    capture quietly testparm i.t15_industry_broad
                }
                else {
                    capture quietly testparm i.t15_industry_detail
                }
                if !_rc local p_industry = r(p)
            }
            if `m' == 3 {
                capture quietly testparm i.t15_policy_intensity
                if !_rc local p_policy = r(p)
                capture quietly test                     ///
                    2.t15_policy_intensity =             ///
                    1.t15_policy_intensity
                if !_rc local p_key = r(p)
            }

            quietly estadd scalar P_position = `p_position'
            quietly estadd scalar P_industry = `p_industry'
            quietly estadd scalar P_policy = `p_policy'
            quietly estadd scalar P_key_vs_promoted = `p_key'

            post `t15_testpost' ("`AI'") ("`outcome'") (`m') ///
                (e(N)) (e(N_clust)) (`p_position')       ///
                (`p_industry') (`p_policy') (`p_key')

            local focal `coef_common'
            if `m' == 2 local focal `focal' `coef_industry'
            if `m' == 3 local focal `focal' `coef_policy'
            if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                local focal `coef_common'
                if `m' == 2 local focal `focal' `coef_industry_broad'
            }

            foreach coef of local focal {
                capture scalar t15_b = _b[`coef']
                if !_rc {
                    scalar t15_se = _se[`coef']
                    scalar t15_or = exp(t15_b)
                    scalar t15_p = 2*normal(-abs(t15_b/t15_se))
                    scalar t15_ll = exp(t15_b-1.96*t15_se)
                    scalar t15_ul = exp(t15_b+1.96*t15_se)
                    post `t15_coefpost' ("`AI'") ("`outcome'") ///
                        (`m') ("`coef'") (t15_or) (t15_se) ///
                        (t15_p) (t15_ll) (t15_ul)
                }
            }
        }
    }
}

postclose `t15_coefpost'
postclose `t15_testpost'

* Ordered-logit proportional-odds diagnostics for the two substantive field
* specifications. The command is user written and may reject weighted/VCE
* results, so diagnostic failure is reported without terminating estimation.
capture which brant
if _rc {
    display as text "Brant diagnostic not run: command brant is unavailable."
    display as text "Use a generalized ordered-logit sensitivity analysis before submission."
}
else {
    foreach AI in GAI PAI {
        foreach OUT in BREADTH TIME {
            foreach m of numlist 2/3 {
                local model T15_`AI'_`OUT'_M`m'
                estimates restore `model'
                display as text "Proportional-odds diagnostic for `model':"
                capture noisily brant, detail
                if _rc {
                    display as text "brant could not evaluate `model' with the current weight/VCE specification."
                }
            }
        }
    }
}


*--------------------------------------------------------------------*
* 10. PUBLICATION-READY RTF TABLES
*--------------------------------------------------------------------*

* esttab does not accept factor-variable wildcards such as *.variable in
* keep() or order(). Use the explicit coefficient names defined above.
local keep_detail                                       ///
    `coef_common' `coef_industry' `coef_policy'

local keep_pai_consequence                              ///
    `coef_common' `coef_industry_broad'

local table_notes                                        ///
    "Entries are odds ratios; city-clustered standard errors are in parentheses. Specialised AI use and consequence outcomes use logit; breadth and time use ordered logit." ///
    "M1 includes employment/student position and controls. M2 adds detailed industry. M3 replaces detailed industry with policy intensity; the policy variable is not entered together with its constituent industry indicators." ///
    "Controls are sex, age and age squared, education, IHS equivalized household income, marital status, hukou/residence, city tier, region, and CCP membership; their coefficients are omitted." ///
    "Policy counts include distinct central promotion/application documents issued by 31 May 2025. Categories are no promotion, 1-2 appearances, and key promotion (3+ appearances or the AI-producing information industry)." ///
    "Non-employed respondents are retained through employment/student position. A neutral industry base value does not classify them as workers. Respondents with genuinely unavailable industry are excluded. Within each outcome, M1-M3 use identical observations." ///
    "The sample is aged 16-65 and uses the configured `ai_analysis_weight' survey weight. Breadth and time include confirmed nonusers as zero; consequence models include only confirmed users with valid responses. Results are associational." ///
    "Policy intensity classifies industries by policy alignment and does not identify a causal policy effect."

local table_notes_pai_consequence                       ///
    "Entries are odds ratios from logit models with city-clustered standard errors in parentheses." ///
    "M1 includes employment/student position and controls. Because the Specialised AI consequence sample is sparse, M2 adds four broad industry fields rather than fourteen detailed industries." ///
    "The broad fields are production and infrastructure; consumer, logistics, and other services; information and knowledge-intensive market services; and education, health, and public services." ///
    "Controls are sex, age and age squared, education, IHS equivalized household income, marital status, hukou/residence, city tier, region, and CCP membership; their coefficients are omitted." ///
    "The sample contains respondents aged 16-65 who used Specialised AI and supplied a valid consequence response. M1 and M2 use identical observations and the configured `ai_analysis_weight' survey weight." ///
    "The policy model is not estimated for these outcomes because sparse outcome-by-policy cells produce complete or near-complete prediction. The results are exploratory associations."

esttab T15_GAI_BREADTH_M1 T15_GAI_BREADTH_M2          ///
       T15_GAI_BREADTH_M3 T15_GAI_TIME_M1             ///
       T15_GAI_TIME_M2 T15_GAI_TIME_M3 using          ///
    "$t15_tables/Table5A_GAI_industry_policy.rtf",    ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Breadth M1" "Breadth M2" "Breadth M3"   ///
            "Time M1" "Time M2" "Time M3")           ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_promoted,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: detailed industry"          ///
                 "Joint p: policy intensity"           ///
                 "p: key promoted = promoted"))        ///
    title("Table 5A. Industry, policy intensity, and Generative AI incorporation") ///
    addnotes(`table_notes')

esttab T15_PAI_USE_M1 T15_PAI_USE_M2 T15_PAI_USE_M3   ///
       T15_PAI_BREADTH_M1 T15_PAI_BREADTH_M2          ///
       T15_PAI_BREADTH_M3 T15_PAI_TIME_M1             ///
       T15_PAI_TIME_M2 T15_PAI_TIME_M3 using          ///
    "$t15_tables/Table5B_PAI_industry_policy.rtf",    ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Use M1" "Use M2" "Use M3"               ///
            "Breadth M1" "Breadth M2" "Breadth M3"   ///
            "Time M1" "Time M2" "Time M3")           ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_promoted,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: detailed industry"          ///
                 "Joint p: policy intensity"           ///
                 "p: key promoted = promoted"))        ///
    title("Table 5B. Industry, policy intensity, and Specialised AI incorporation") ///
    addnotes(`table_notes')

esttab T15_GAI_AUG_M1 T15_GAI_AUG_M2 T15_GAI_AUG_M3   ///
       T15_GAI_PRESSURE_M1 T15_GAI_PRESSURE_M2         ///
       T15_GAI_PRESSURE_M3 using                       ///
    "$t15_tables/Table5C_GAI_industry_consequences.rtf", ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Augmentation M1" "Augmentation M2"        ///
            "Augmentation M3" "Pressure M1"           ///
            "Pressure M2" "Pressure M3")              ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_promoted,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: detailed industry"          ///
                 "Joint p: policy intensity"           ///
                 "p: key promoted = promoted"))        ///
    title("Table 5C. Institutional position and perceived consequences of Generative AI") ///
    addnotes(`table_notes')

esttab T15_PAI_AUG_M1 T15_PAI_AUG_M2                  ///
       T15_PAI_PRESSURE_M1 T15_PAI_PRESSURE_M2 using  ///
    "$t15_tables/Table5D_PAI_industry_consequences.rtf", ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_pai_consequence', relax)                ///
    mtitles("Augmentation M1" "Augmentation M2"        ///
            "Pressure M1" "Pressure M2")              ///
    stats(N N_clust P_position P_industry,              ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
