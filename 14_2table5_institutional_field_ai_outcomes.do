        if t15_sample_pai_`outcome' == 1, missing
}


*--------------------------------------------------------------------*
* 9. MODEL SEQUENCE AND ESTIMATION
*--------------------------------------------------------------------*

local controls                                           ///
    c.t15_age c.t15_age_sq i.t15_female                ///
    ib1.t15_education c.t15_ihs_eqincome               ///
    i.t15_marriage i.t15_hukoulive                     ///
    ib1.t15_city_tier ib1.t15_region i.t15_ccp

local model1 ib1.t15_empstudent `controls'
local model2 i.t15_employed_student                    ///
    ib2.t15_institution_field `controls'
local model3 i.t15_employed_student                    ///
    ib1.t15_policy_alignment `controls'
local model2_pai_consequence ib1.t15_empstudent        ///
    ib1.t15_industry_broad `controls'

local coef_common                                        ///
    2.t15_empstudent 3.t15_empstudent 4.t15_empstudent
local coef_field                                         ///
    1.t15_institution_field 3.t15_institution_field    ///
    4.t15_institution_field 5.t15_institution_field    ///
    6.t15_institution_field 7.t15_institution_field    ///
    8.t15_institution_field 9.t15_institution_field    ///
    10.t15_institution_field 11.t15_institution_field  ///
    12.t15_institution_field 13.t15_institution_field  ///
    14.t15_institution_field 15.t15_institution_field  ///
    16.t15_institution_field
local coef_policy                                        ///
    2.t15_policy_alignment 3.t15_policy_alignment      ///
    4.t15_policy_alignment 5.t15_policy_alignment
local coef_industry_broad                               ///
    2.t15_industry_broad 3.t15_industry_broad          ///
    4.t15_industry_broad

tempfile t15_focal_results t15_model_tests
tempname t15_coefpost t15_testpost
postfile `t15_coefpost' str3 AI str12 Outcome byte Model ///
    str40 Coef double Odds_ratio Log_SE P_value         ///
    CI_low CI_high using `t15_focal_results', replace
postfile `t15_testpost' str3 AI str12 Outcome byte Model ///
    long Observations City_clusters double              ///
    P_position P_industry P_policy P_key_vs_priority   ///
    using `t15_model_tests', replace

eststo clear

foreach ai in gai pai {
    if "`ai'" == "gai" local AI "GAI"
    if "`ai'" == "pai" local AI "PAI"

    local outcome_list "breadth time aug pressure"
    if "`ai'" == "pai" local outcome_list "use breadth time aug pressure"

    foreach outcome of local outcome_list {
        local estimator "logit"
        if "`outcome'" == "breadth" local estimator "ologit"
        if "`outcome'" == "time"    local estimator "ologit"

        local model_numbers "1 2 3"
        if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
            local model_numbers "1 2"
        }

        foreach m of local model_numbers {
            local rhs "`model1'"
            if `m' == 2 local rhs "`model2'"
            if `m' == 3 local rhs "`model3'"
            if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                if `m' == 2 local rhs "`model2_pai_consequence'"
            }

            display as text "Estimating `AI' `outcome', M`m' (`estimator')"
            capture quietly `estimator' t15_`ai'_`outcome' `rhs' ///
                if t15_sample_`ai'_`outcome' == 1       ///
                [pweight=t15_weight],                   ///
                vce(cluster t15_city_cluster) difficult iterate(500)

            local fit_rc = _rc
            if `fit_rc' {
                display as error "Model failed: `AI' `outcome', M`m'; return code `fit_rc'."
                display as error "Outcome-by-policy counts are shown below to diagnose sparse or separated cells."
                if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                    tabulate t15_industry_broad         ///
                        t15_`ai'_`outcome'              ///
                        if t15_sample_`ai'_`outcome' == 1, missing
                }
                else {
                    tabulate t15_policy_alignment       ///
                        t15_`ai'_`outcome'              ///
                        if t15_sample_`ai'_`outcome' == 1, missing
                }
                capture postclose `t15_coefpost'
                capture postclose `t15_testpost'
                log close
                exit `fit_rc'
            }

            local OUT = upper("`outcome'")
            local estname T15_`AI'_`OUT'_M`m'
            eststo `estname'

            local p_position = .
            if `m' == 1 | ("`ai'" == "pai" &          ///
                inlist("`outcome'", "aug", "pressure")) {
                capture quietly testparm i.t15_empstudent
                if !_rc local p_position = r(p)
            }
            local p_industry = .
            local p_policy = .
            local p_key = .

            if `m' == 2 {
                if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                    capture quietly testparm i.t15_industry_broad
                }
                else {
                    capture quietly testparm i.t15_institution_field
                }
                if !_rc local p_industry = r(p)
            }
            if `m' == 3 {
                * The joint policy test compares only the two employed
                * AI+ field categories with the employed non-named base.
                * Student and outside-employment categories remain controls.
                capture quietly testparm                    ///
                    2.t15_policy_alignment                 ///
                    3.t15_policy_alignment
                if !_rc local p_policy = r(p)
                capture quietly test                     ///
                    3.t15_policy_alignment =             ///
                    2.t15_policy_alignment
                if !_rc local p_key = r(p)
            }

            quietly estadd scalar P_position = `p_position'
            quietly estadd scalar P_industry = `p_industry'
            quietly estadd scalar P_policy = `p_policy'
            quietly estadd scalar P_key_vs_priority = `p_key'

            post `t15_testpost' ("`AI'") ("`outcome'") (`m') ///
                (e(N)) (e(N_clust)) (`p_position')       ///
                (`p_industry') (`p_policy') (`p_key')

            local focal `coef_common'
            if `m' == 2 local focal `coef_field'
            if `m' == 3 local focal `coef_policy'
            if "`ai'" == "pai" & inlist("`outcome'", "aug", "pressure") {
                local focal `coef_common'
                if `m' == 2 local focal `focal' `coef_industry_broad'
            }

            foreach coef of local focal {
                capture scalar t15_b = _b[`coef']
                if !_rc {
                    scalar t15_se = _se[`coef']
                    scalar t15_or = exp(t15_b)
                    scalar t15_p = 2*normal(-abs(t15_b/t15_se))
                    scalar t15_ll = exp(t15_b-1.96*t15_se)
                    scalar t15_ul = exp(t15_b+1.96*t15_se)
                    post `t15_coefpost' ("`AI'") ("`outcome'") ///
                        (`m') ("`coef'") (t15_or) (t15_se) ///
                        (t15_p) (t15_ll) (t15_ul)
                }
            }
        }
    }
}

postclose `t15_coefpost'
postclose `t15_testpost'

* Ordered-logit proportional-odds diagnostics for the two substantive field
* specifications. The command is user written and may reject weighted/VCE
* results, so diagnostic failure is reported without terminating estimation.
capture which brant
if _rc {
    display as text "Brant diagnostic not run: command brant is unavailable."
    display as text "Use a generalized ordered-logit sensitivity analysis before submission."
}
else {
    foreach AI in GAI PAI {
        foreach OUT in BREADTH TIME {
            foreach m of numlist 2/3 {
                local model T15_`AI'_`OUT'_M`m'
                estimates restore `model'
                display as text "Proportional-odds diagnostic for `model':"
                capture noisily brant, detail
                if _rc {
                    display as text "brant could not evaluate `model' with the current weight/VCE specification."
                }
            }
        }
    }
}


*--------------------------------------------------------------------*
* 10. PUBLICATION-READY RTF TABLES
*--------------------------------------------------------------------*

* esttab does not accept factor-variable wildcards such as *.variable in
* keep() or order(). Use the explicit coefficient names defined above.
local keep_detail                                       ///
    `coef_common' `coef_field' `coef_policy'

local keep_pai_consequence                              ///
    `coef_common' `coef_industry_broad'

local table_notes                                        ///
    "Entries are odds ratios; city-clustered standard errors are in parentheses. Specialised AI use and consequence outcomes use logit; breadth and time use ordered logit." ///
    "M1 includes employment/student position and controls. M2 replaces that position measure with detailed institutional fields. M3 replaces detailed fields with their AI+ policy alignment. M2 and M3 also adjust for being employed and in school." ///
    "Controls are sex, age and age squared, education, IHS equivalized household income, marital status, hukou/residence, city tier, region, and CCP membership; their coefficients are omitted." ///
    "AI+ alignment follows the State Council's six action fields. Key industrial development fields are agriculture, mining/manufacturing, wholesale/retail, transport/logistics/postal services, information/software/IT, and finance. Other priority fields are construction, real estate, science/education/culture/health, resident services, and public administration." ///
    "Non-employed students form an education field; respondents outside employment and education form a separate category. Employed respondents with unavailable industry are excluded. Within each outcome, M1-M3 use identical observations." ///
    "The sample contains the selected household questionnaire respondents aged 16-59 who were not engaged in farming and uses the configured `ai_analysis_weight' survey weight. Breadth and time include confirmed nonusers as zero; consequence models include only confirmed users with valid responses. Results are associational." ///
    "The policy was adopted on 21 August 2025, after the June interviews. Alignment therefore describes whether observed fields match the later national priority framework; it does not identify a causal policy effect."

local table_notes_pai_consequence                       ///
    "Entries are odds ratios from logit models with city-clustered standard errors in parentheses." ///
    "M1 includes employment/student position and controls. Because the Specialised AI consequence sample is sparse, M2 adds four broad industry fields rather than fourteen detailed industries." ///
    "The broad fields are production and infrastructure; consumer, logistics, and other services; information and knowledge-intensive market services; and education, health, and public services." ///
    "Controls are sex, age and age squared, education, IHS equivalized household income, marital status, hukou/residence, city tier, region, and CCP membership; their coefficients are omitted." ///
    "The sample contains selected household questionnaire respondents aged 16-59 who were not engaged in farming, used Specialised AI, and supplied a valid consequence response. M1 and M2 use identical observations and the configured `ai_analysis_weight' survey weight." ///
    "The policy model is not estimated for these outcomes because sparse outcome-by-policy cells produce complete or near-complete prediction. The results are exploratory associations."

esttab T15_GAI_BREADTH_M1 T15_GAI_BREADTH_M2          ///
       T15_GAI_BREADTH_M3 T15_GAI_TIME_M1             ///
       T15_GAI_TIME_M2 T15_GAI_TIME_M3 using          ///
    "$t15_tables/Table5A_GAI_AIplus_alignment.rtf",  ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Breadth M1" "Breadth M2" "Breadth M3"   ///
            "Time M1" "Time M2" "Time M3")           ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_priority,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: institutional field"        ///
                 "Joint p: AI+ fields among employed"  ///
                 "p: key industrial = other priority")) ///
    title("Table 5A. Institutional field, AI+ alignment, and Generative AI incorporation") ///
    addnotes(`table_notes')

esttab T15_PAI_USE_M1 T15_PAI_USE_M2 T15_PAI_USE_M3   ///
       T15_PAI_BREADTH_M1 T15_PAI_BREADTH_M2          ///
