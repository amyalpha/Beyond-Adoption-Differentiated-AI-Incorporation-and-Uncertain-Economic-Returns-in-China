*--------------------------------------------------------------------*

local sample_vars                                        ///
    t15_age t15_age_sq t15_female t15_education         ///
    t15_ihs_eqincome t15_marriage t15_hukoulive         ///
    t15_city_tier t15_region t15_ccp t15_empstudent     ///
    t15_employed_student t15_institution_field          ///
    t15_policy_alignment                                ///
    t15_weight t15_city_cluster

egen byte t15_miss_base = rowmiss(`sample_vars')
gen byte t15_base = t15_ai_eligible25 == 1 &           ///
    t15_miss_base == 0

foreach outcome in gai_use gai_breadth gai_time gai_aug gai_pressure ///
                   pai_use pai_breadth pai_time pai_aug pai_pressure {
