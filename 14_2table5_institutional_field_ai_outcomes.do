version 16.0
set more off

/*
    TABLE 5: INSTITUTIONAL FIELD, AI INCORPORATION, AND CONSEQUENCES

    Run this file with the final person-level WIDE dataset already open.
    It does not load, merge, append, reshape, or overwrite the data.

    For each Generative AI and Specialised AI outcome, the file estimates
    three models:
      M1. Employment/student position + controls
      M2. Detailed institutional field + controls
      M3. AI+ policy alignment of the institutional field + controls.
    M2 and M3 replace employment/student position with field categories
    that retain non-employed students and respondents outside employment.

    Main incorporation outcomes are breadth and daily time. Binary Generative
    AI use is excluded from the main models because adoption is nearly
    universal and causes complete prediction. Specialised AI use is retained.
    Consequence outcomes are productive augmentation and adaptive pressure.

    Policy alignment follows the fields named in the State Council's
    Opinions on Deepening the Implementation of the "Artificial
    Intelligence Plus" Action (State Council Document No. 11 [2025]).
    The document was adopted on 21 August 2025, after the June interviews.
    It therefore supplies an authoritative classification of national
    priorities, not a pre-survey treatment or causal exposure measure.
    Genuinely unavailable industry is missing. Industry code 14 remains
    "Other industry" and is never treated as missing.

    The analysis retains person records with valid AI outcomes and covariates.
*/


*--------------------------------------------------------------------*
* 0. OUTPUT, LOG, AND CLEANUP
*--------------------------------------------------------------------*

if `"$project_root"' == "" global project_root "."

* Household weights are the default because the AI module comes from the
* household questionnaire. Change to "individual" only if the AI module
* independently sampled persons.
local ai_analysis_weight "household"

global t15_results "$project_root/results/main_tables"
global t15_tables  "$t15_results/tables"
global t15_logs    "$t15_results/logs"

capture mkdir "$project_root/results"
capture mkdir "$t15_results"
capture mkdir "$t15_tables"
capture mkdir "$t15_logs"

capture log close _all
log using "$t15_logs/14_table5_ai_plus_key_industries.log", ///
    text replace

* Drop only variables generated by an earlier run of this file.
capture drop t15_*

capture which esttab
if _rc {
    display as error "The estout package is required. Install it once with:"
    display as error "ssc install estout"
    log close
    exit 199
}


*--------------------------------------------------------------------*
* 1. LOCATE DEMOGRAPHIC AND INSTITUTIONAL-FIELD VARIABLES
*--------------------------------------------------------------------*

foreach id in hhid pline {
    capture confirm variable `id'
    if _rc {
        display as error "Required identifier `id' is absent."
        log close
        exit 111
    }
}

foreach v in ai_respondent_pline_w25 main_work_type_w25 {
    capture confirm variable `v'
    if _rc {
        display as error "Required respondent-routing variable `v' is absent."
        display as error "Retain A1013 and main_work_type when rebuilding the wide data."
        log close
        exit 111
    }
}

local agevar ""
foreach candidate in age_w25 age2025 {
    capture confirm variable `candidate'
    if !_rc & `"`agevar'"' == "" local agevar `candidate'
}

local birthyearvar ""
foreach candidate in birthyear_w25 birthy_w25 birthyear2025 {
    capture confirm variable `candidate'
    if !_rc & `"`birthyearvar'"' == "" local birthyearvar `candidate'
}
if `"`agevar'"' == "" & `"`birthyearvar'"' == "" {
    display as error "Neither 2025 age nor 2025 birth year was found."
    log close
    exit 111
}

local sexvar ""
foreach candidate in sex_w25 sex2025 {
    capture confirm variable `candidate'
    if !_rc & `"`sexvar'"' == "" local sexvar `candidate'
}

local educationvar ""
foreach candidate in education_w25 edulev_w25 education2025 {
    capture confirm variable `candidate'
    if !_rc & `"`educationvar'"' == "" local educationvar `candidate'
}

local marriagevar ""
foreach candidate in marriage_w25 marriage2025 {
    capture confirm variable `candidate'
    if !_rc & `"`marriagevar'"' == "" local marriagevar `candidate'
}

local eqincomevar ""
foreach candidate in eq_income_w25 eq_income_alt_w25    ///
                         eqincome_w25 eqincome1_w25      ///
                         equivalized_income_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`eqincomevar'"' == "" local eqincomevar `candidate'
}

local jobvar ""
foreach candidate in havejob_w25 havejob2025 {
    capture confirm variable `candidate'
    if !_rc & `"`jobvar'"' == "" local jobvar `candidate'
}

local schoolvar ""
foreach candidate in inschool_w25 inedu_w25 inedu2025 still_school_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`schoolvar'"' == "" local schoolvar `candidate'
}

local industryvar ""
foreach candidate in industry_w25 industry2025 {
    capture confirm variable `candidate'
    if !_rc & `"`industryvar'"' == "" local industryvar `candidate'
}

local hukouvar ""
foreach candidate in hukouknlv_w25 hukounlive_w25 hukouknlv1_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`hukouvar'"' == "" local hukouvar `candidate'
}

local citytiervar ""
foreach candidate in city_level_w25 citylevel_w25 city_level2025 {
    capture confirm variable `candidate'
    if !_rc & `"`citytiervar'"' == "" local citytiervar `candidate'
}

local regionvar ""
foreach candidate in region_w25 region2025 {
    capture confirm variable `candidate'
    if !_rc & `"`regionvar'"' == "" local regionvar `candidate'
}

local partyvar ""
foreach candidate in party_w25 partym_w25 partym2025 party_member_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`partyvar'"' == "" local partyvar `candidate'
}

local required_aliases sexvar educationvar marriagevar eqincomevar ///
                       jobvar schoolvar industryvar                 ///
                       hukouvar                                    ///
                       citytiervar regionvar partyvar
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 2. LOCATE THE GAI AND PAI OUTCOMES
*--------------------------------------------------------------------*

local gaiuse ""
foreach candidate in gai_use_w25 gai_use_raw_w25 gai_use2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaiuse'"' == "" local gaiuse `candidate'
}

local gaibreadth ""
foreach candidate in gai_breadth_w25 gai_tool_cat_w25 gai_breadth2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaibreadth'"' == "" local gaibreadth `candidate'
}

local gaitime ""
foreach candidate in gai_time_w25 useAI_time_w25 T1007a_w25 t1007a_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`gaitime'"' == "" local gaitime `candidate'
}

local gaiaug ""
foreach candidate in gai_augmentation_w25 gai_augmentation2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaiaug'"' == "" local gaiaug `candidate'
}

local gaipressure ""
foreach candidate in gai_pressure_w25 gai_pressure2025 {
    capture confirm variable `candidate'
    if !_rc & `"`gaipressure'"' == "" local gaipressure `candidate'
}

local paiuse ""
foreach candidate in pai_use_w25 pai_use_raw_w25 pai_use2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paiuse'"' == "" local paiuse `candidate'
}

local paibreadth ""
foreach candidate in pai_breadth_w25 pai_tool_cat_w25 pai_breadth2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paibreadth'"' == "" local paibreadth `candidate'
}

local paitime ""
foreach candidate in pai_time_w25 usePAI_time_w25 T1007b_w25 t1007b_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`paitime'"' == "" local paitime `candidate'
}

local paiaug ""
foreach candidate in pai_augmentation_w25 pai_augmentation2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paiaug'"' == "" local paiaug `candidate'
}

local paipressure ""
foreach candidate in pai_pressure_w25 pai_pressure2025 {
    capture confirm variable `candidate'
    if !_rc & `"`paipressure'"' == "" local paipressure `candidate'
}

local required_aliases gaiuse gaibreadth gaitime gaiaug gaipressure ///
                       paiuse paibreadth paitime paiaug paipressure
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required AI-outcome alias `alias' was not found."
        log close
        exit 111
    }
}


*--------------------------------------------------------------------*
* 3. LOCATE WEIGHTS AND GEOGRAPHIC CLUSTERS
*--------------------------------------------------------------------*

local householdweightvar ""
foreach candidate in household_weight_w25 weight_hh_w25 wgt_hh_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`householdweightvar'"' == "" {
        local householdweightvar `candidate'
    }
}

local individualweightvar ""
foreach candidate in individual_weight_w25 weight_ind_w25 wgt_ind_w25 {
    capture confirm variable `candidate'
    if !_rc & `"`individualweightvar'"' == "" {
        local individualweightvar `candidate'
    }
}

local weightvar ""
if `"`ai_analysis_weight'"' == "household" {
    local weightvar `householdweightvar'
}
else if `"`ai_analysis_weight'"' == "individual" {
    local weightvar `individualweightvar'
}
else {
    display as error "ai_analysis_weight must be household or individual."
    log close
    exit 198
}

local provincevar ""
foreach candidate in province_w25 prov_code_w25 province_w23 prov_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`provincevar'"' == "" local provincevar `candidate'
}

local cityvar ""
foreach candidate in city_w25 city_code_w25 city_w23 city_code_w23 {
    capture confirm variable `candidate'
    if !_rc & `"`cityvar'"' == "" local cityvar `candidate'
}

local required_aliases weightvar provincevar cityvar
foreach alias of local required_aliases {
    if `"``alias''"' == "" {
        display as error "Required survey-design alias `alias' was not found."
        log close
        exit 111
    }
}

display as text "Variables selected:"
display as result "Employment/school/industry: `jobvar' / `schoolvar' / `industryvar'"
display as result "GAI outcomes: `gaiuse' `gaibreadth' `gaitime' `gaiaug' `gaipressure'"
display as result "PAI outcomes: `paiuse' `paibreadth' `paitime' `paiaug' `paipressure'"
display as result "Analysis weight (`ai_analysis_weight'): `weightvar'"


*--------------------------------------------------------------------*
* 4. CONSTRUCT DEMOGRAPHIC AND GEOGRAPHIC CONTROLS
*--------------------------------------------------------------------*

gen double t15_age = .
if `"`agevar'"' != "" {
    replace t15_age = `agevar' if inrange(`agevar', 16, 59)
}
else {
    replace t15_age = 2025-`birthyearvar'               ///
        if inrange(2025-`birthyearvar', 16, 59)
}
gen double t15_age_sq = t15_age^2 if !missing(t15_age)

gen byte t15_ai_respondent25 =                         ///
    pline == ai_respondent_pline_w25                   ///
    if !missing(pline, ai_respondent_pline_w25)

* Constructed variables accept only substantive codes. Stata's extended
* missings (.a-.z, including .d and .n) and survey nonresponse codes such
* as 7777 therefore remain missing without stopping the do-file.
gen byte t15_female = `sexvar' == 2 if inlist(`sexvar', 1, 2)
label define t15_female_lbl 0 "Male" 1 "Female", replace
label values t15_female t15_female_lbl

gen byte t15_education = .
replace t15_education = 1 if inrange(`educationvar', 0, 2)
replace t15_education = 2 if inlist(`educationvar', 3, 4)
replace t15_education = 3 if inrange(`educationvar', 5, 7)
label define t15_education_lbl                          ///
    1 "Compulsory education or less"                   ///
    2 "Upper-secondary or vocational"                 ///
    3 "Tertiary education", replace
label values t15_education t15_education_lbl

gen double t15_eqincome_10k = `eqincomevar'/10000       ///
    if !missing(`eqincomevar')
gen double t15_ihs_eqincome = asinh(t15_eqincome_10k)
label variable t15_ihs_eqincome                         ///
    "IHS equivalized household income, 2024"

gen byte t15_marriage = `marriagevar' if               ///
    inrange(`marriagevar', 1, 6)
gen byte t15_hukoulive = `hukouvar' if                 ///
    inrange(`hukouvar', 1, 4)
gen byte t15_city_tier = `citytiervar' if              ///
    inrange(`citytiervar', 1, 3)
gen byte t15_region = `regionvar' if                   ///
    inrange(`regionvar', 1, 4)

label define t15_city_tier_en                           ///
    1 "First-tier and new first-tier cities"           ///
    2 "Second-tier cities"                             ///
    3 "Third-tier cities and below", replace
label values t15_city_tier t15_city_tier_en

label define t15_region_en                              ///
    1 "East"                                           ///
    2 "Central"                                        ///
    3 "West"                                           ///
    4 "Northeast", replace
label values t15_region t15_region_en

gen byte t15_ccp = .
replace t15_ccp = 1 if `partyvar' == 1
replace t15_ccp = 0 if inlist(`partyvar', 0, 2, 3, 4)
label define t15_ccp_lbl 0 "Not a CCP member" 1 "CCP member", replace
label values t15_ccp t15_ccp_lbl

gen double t15_weight = `weightvar' if                 ///
    !missing(`weightvar') & `weightvar' > 0 &          ///
    !inlist(`weightvar', 7777, 7788, 9999)

egen int t15_province = group(`provincevar')
egen long t15_city_cluster = group(`provincevar' `cityvar')


*--------------------------------------------------------------------*
* 5. EMPLOYMENT-STUDENT POSITION AND INSTITUTIONAL FIELD
*--------------------------------------------------------------------*

* No validation error is issued for nonresponse codes. Only exact 0/1
* values enter employment/student status. Detailed industry accepts 1-14;
* all other values, including 7777, become missing because "Other industry"
* has already been harmonized to code 14.

* Employment/student status defines M1. M2 and M3 use integrated field
* categories below so that students and non-employed respondents remain in
* the analysis without receiving an artificial employed-industry value.
gen byte t15_empstudent = .
replace t15_empstudent = 1 if `jobvar' == 1 & `schoolvar' == 0
replace t15_empstudent = 2 if `jobvar' == 1 & `schoolvar' == 1
replace t15_empstudent = 3 if `jobvar' == 0 & `schoolvar' == 1
replace t15_empstudent = 4 if `jobvar' == 0 & `schoolvar' == 0
label define t15_empstudent_lbl                          ///
    1 "Employed, not in school"                        ///
    2 "Employed and in school"                         ///
    3 "In school, not employed"                        ///
    4 "Neither employed nor in school", replace
label values t15_empstudent t15_empstudent_lbl

* The AI-module route includes nonworking respondents but excludes farmers.
gen byte t15_nonfarm25 = .
replace t15_nonfarm25 = 1 if `jobvar' == 0
replace t15_nonfarm25 = 1 if `jobvar' == 1 &           ///
    inlist(main_work_type_w25, 1, 2, 3)
replace t15_nonfarm25 = 0 if `jobvar' == 1 &           ///
    main_work_type_w25 == 4
gen byte t15_ai_eligible25 = t15_ai_respondent25 == 1 & ///
    !missing(t15_age) & t15_nonfarm25 == 1

* The dual-position indicator distinguishes workers who are also students
* once the integrated field categories replace t15_empstudent in M2-M3.
gen byte t15_employed_student = t15_empstudent == 2 if ///
    !missing(t15_empstudent)
label variable t15_employed_student "Employed and in school"

* Mining/manufacturing (2) is the detailed-field reference. Employed
* respondents use their reported industry. Non-employed students form an
* education field, and respondents in neither position form a separate
* outside-employment-and-education category.
gen byte t15_institution_field = `industryvar' if `jobvar' == 1 & ///
    inrange(`industryvar', 1, 14)
replace t15_institution_field = 15 if `jobvar' == 0 & `schoolvar' == 1
replace t15_institution_field = 16 if `jobvar' == 0 & `schoolvar' == 0
label define t15_institution_field_lbl                   ///
    1 "Agriculture, forestry, animal husbandry, fishing" ///
    2 "Mining and manufacturing"                       ///
    3 "Construction"                                   ///
    4 "Electricity, heat, gas, and water utilities"    ///
    5 "Wholesale and retail"                           ///
    6 "Transport, storage, and postal services"        ///
    7 "Accommodation and food services"                ///
    8 "Information, software, and IT services"         ///
    9 "Finance"                                        ///
    10 "Real estate"                                   ///
    11 "Science, education, culture, and health"       ///
    12 "Resident, repair, and other services"          ///
    13 "Public administration and social organizations" ///
    14 "Other industry"                                ///
    15 "Student education field"                       ///
    16 "Outside employment and education", replace
label values t15_institution_field t15_institution_field_lbl


*--------------------------------------------------------------------*
* 6. AI+ POLICY ALIGNMENT OF INSTITUTIONAL FIELDS
*--------------------------------------------------------------------*

/*
    Source: State Council Document No. 11 [2025], adopted 21 August 2025.

    Category 1: industries not explicitly named as an application field
                in the document (CHFS 4, 7, 14).
    Category 2: fields named under consumption, wellbeing, or governance
                actions (CHFS 3, 10, 11, 12, 13).
    Category 3: key fields named in the "AI+ industrial development"
                action (CHFS 1, 2, 5, 6, 8, 9).
    Category 4: non-employed students, because education is explicitly
                identified as an AI+ field.
    Category 5: respondents outside employment and education.

    The CHFS industry groups are broad. Mining is bundled with
    manufacturing, while science, education, culture, and health share one
    code. The classification must therefore be interpreted at the observed
    CHFS-field level. Because the policy postdates fieldwork, the measure
    tests alignment with the national priority framework, not policy effects.
*/

gen byte t15_policy_alignment = .
replace t15_policy_alignment = 1 if `jobvar' == 1 &    ///
    inlist(`industryvar', 4, 7, 14)
replace t15_policy_alignment = 2 if `jobvar' == 1 &    ///
    inlist(`industryvar', 3, 10, 11, 12, 13)
replace t15_policy_alignment = 3 if `jobvar' == 1 &    ///
    inlist(`industryvar', 1, 2, 5, 6, 8, 9)
replace t15_policy_alignment = 4 if `jobvar' == 0 & `schoolvar' == 1
replace t15_policy_alignment = 5 if `jobvar' == 0 & `schoolvar' == 0
label define t15_policy_alignment_lbl                   ///
    1 "Industry not explicitly named"                 ///
    2 "Other AI+ priority field"                       ///
    3 "Key AI+ industrial development field"          ///
    4 "Student education field"                       ///
    5 "Outside employment and education", replace
label values t15_policy_alignment t15_policy_alignment_lbl

* The specialised-AI consequence sample is much smaller than the main
* incorporation samples. Four broad institutional fields replace fourteen
* detailed industries in that analysis to avoid quasi-separation.
gen byte t15_industry_broad = 1 if `jobvar' == 0
replace t15_industry_broad = 1 if `jobvar' == 1 &       ///
    inlist(`industryvar', 1, 2, 3, 4)
replace t15_industry_broad = 2 if `jobvar' == 1 &       ///
    inlist(`industryvar', 5, 6, 7, 10, 12, 14)
replace t15_industry_broad = 3 if `jobvar' == 1 &       ///
    inlist(`industryvar', 8, 9)
replace t15_industry_broad = 4 if `jobvar' == 1 &       ///
    inlist(`industryvar', 11, 13)
label define t15_industry_broad_lbl                     ///
    1 "Production and infrastructure"                 ///
    2 "Consumer, logistics, and other services"       ///
    3 "Information and knowledge-intensive market services" ///
    4 "Education, health, and public services", replace
label values t15_industry_broad t15_industry_broad_lbl

display as text "Employment/student position:"
tabulate t15_empstudent if t15_ai_eligible25 == 1, missing
display as text "Detailed institutional field:"
tabulate t15_institution_field if t15_ai_eligible25 == 1, missing
display as text "AI+ policy alignment:"
tabulate t15_policy_alignment if t15_ai_eligible25 == 1, missing
display as text "Broad industry fields used for Specialised AI consequences:"
tabulate t15_industry_broad if t15_ai_eligible25 == 1, missing


*--------------------------------------------------------------------*
* 7. CONSTRUCT AI INCORPORATION AND PERCEIVED-CONSEQUENCE OUTCOMES
*--------------------------------------------------------------------*

egen byte t15_hh_tag = tag(hhid)
bysort hhid: egen int t15_n_ai_respondent25 =          ///
    total(t15_ai_respondent25 == 1)
bysort hhid: egen byte t15_has_ai25 =                  ///
    max(!missing(`gaiuse') | !missing(`paiuse'))
quietly count if t15_hh_tag == 1 & t15_has_ai25 == 1 & ///
    t15_n_ai_respondent25 != 1
if r(N) > 0 {
    display as error "Some 2025 AI households do not match exactly one A1013 respondent."
    display as error "Rebuild the wide file retaining A1013 as ai_respondent_pline_w25."
    log close
    exit 459
}

quietly count if t15_ai_respondent25 == 1 & t15_has_ai25 == 1
local t15_module_respondents25 = r(N)
display as result "Unique 2025 A1013 AI respondents: " ///
    `t15_module_respondents25'
if `t15_module_respondents25' > 2762 {
    display as error "The 2025 AI respondent count exceeds the household-file maximum of 2,762."
    log close
    exit 459
}

gen byte t15_gai_use = `gaiuse' if inlist(`gaiuse', 0, 1)
gen byte t15_pai_use = `paiuse' if inlist(`paiuse', 0, 1)

* Confirmed nonusers receive zero; genuine missing responses remain missing.
gen byte t15_gai_breadth = 0 if t15_gai_use == 0
replace t15_gai_breadth = `gaibreadth' if t15_gai_use == 1 & ///
    inrange(`gaibreadth', 1, 3)
gen byte t15_pai_breadth = 0 if t15_pai_use == 0
replace t15_pai_breadth = `paibreadth' if t15_pai_use == 1 & ///
    inrange(`paibreadth', 1, 3)

label define t15_breadth_lbl                             ///
    0 "Nonuser" 1 "One AI tool"                       ///
    2 "Two to five AI tools" 3 "More than five AI tools", replace
label values t15_gai_breadth t15_pai_breadth t15_breadth_lbl

* Time may contain questionnaire categories 1-6 or approximate hours.
gen byte t15_gai_time = 0 if t15_gai_use == 0
quietly count if t15_gai_use == 1 & !missing(`gaitime') & ///
    !inlist(`gaitime', 7777, 7788, 9999)
local t15_gai_time_n = r(N)
quietly count if t15_gai_use == 1 & !missing(`gaitime') & ///
    !inlist(`gaitime', 7777, 7788, 9999) &              ///
    !inlist(`gaitime', 1, 2, 3, 4, 5, 6)
local t15_gai_time_noncode = r(N)
if `t15_gai_time_n' == 0 {
    display as error "No valid GAI-time responses among confirmed users."
    log close
    exit 2000
}
if `t15_gai_time_noncode' == 0 {
    replace t15_gai_time = 1 if t15_gai_use == 1 & `gaitime' == 1
    replace t15_gai_time = 2 if t15_gai_use == 1 & `gaitime' == 2
    replace t15_gai_time = 3 if t15_gai_use == 1 &       ///
        inrange(`gaitime', 3, 6)
}
else {
    replace t15_gai_time = 1 if t15_gai_use == 1 &       ///
        `gaitime' > 0 & `gaitime' <= .5
    replace t15_gai_time = 2 if t15_gai_use == 1 &       ///
        `gaitime' > .5 & `gaitime' <= 1
    replace t15_gai_time = 3 if t15_gai_use == 1 &       ///
        `gaitime' > 1 & `gaitime' <= 24
}

gen byte t15_pai_time = 0 if t15_pai_use == 0
quietly count if t15_pai_use == 1 & !missing(`paitime') & ///
    !inlist(`paitime', 7777, 7788, 9999)
local t15_pai_time_n = r(N)
quietly count if t15_pai_use == 1 & !missing(`paitime') & ///
    !inlist(`paitime', 7777, 7788, 9999) &              ///
    !inlist(`paitime', 1, 2, 3, 4, 5, 6)
local t15_pai_time_noncode = r(N)
if `t15_pai_time_n' == 0 {
    display as error "No valid PAI-time responses among confirmed users."
    log close
    exit 2000
}
if `t15_pai_time_noncode' == 0 {
    replace t15_pai_time = 1 if t15_pai_use == 1 & `paitime' == 1
    replace t15_pai_time = 2 if t15_pai_use == 1 & `paitime' == 2
    replace t15_pai_time = 3 if t15_pai_use == 1 &       ///
        inrange(`paitime', 3, 6)
}
else {
    replace t15_pai_time = 1 if t15_pai_use == 1 &       ///
        `paitime' > 0 & `paitime' <= .5
    replace t15_pai_time = 2 if t15_pai_use == 1 &       ///
        `paitime' > .5 & `paitime' <= 1
    replace t15_pai_time = 3 if t15_pai_use == 1 &       ///
        `paitime' > 1 & `paitime' <= 24
}

label define t15_time_lbl                                ///
    0 "Nonuser" 1 "Up to 0.5 hour"                    ///
    2 "0.5-1 hour" 3 "More than 1 hour", replace
label values t15_gai_time t15_pai_time t15_time_lbl

* Consequences are estimated only among confirmed corresponding AI users.
gen byte t15_gai_aug = `gaiaug' if t15_gai_use == 1 &   ///
    inlist(`gaiaug', 0, 1)
gen byte t15_gai_pressure = `gaipressure' if t15_gai_use == 1 & ///
