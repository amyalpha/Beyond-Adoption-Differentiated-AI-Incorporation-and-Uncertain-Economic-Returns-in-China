    replace Row_order = 63 if Coef == "4.t15_policy_alignment"
    replace Predictor = "Student education field" if Row_order == 63
    replace Row_order = 64 if Coef == "5.t15_policy_alignment"
    replace Predictor = "Outside employment and education" if Row_order == 64

    replace Row_order = 71 if Coef == "2.t15_industry_broad"
    replace Predictor = "Consumer, logistics, and other services" if Row_order == 71
    replace Row_order = 72 if Coef == "3.t15_industry_broad"
    replace Predictor = "Information and knowledge-intensive market services" if Row_order == 72
    replace Row_order = 73 if Coef == "4.t15_industry_broad"
    replace Predictor = "Education, health, and public services" if Row_order == 73
    gen byte Outcome_order = .
    replace Outcome_order = 1 if Outcome == "use"
    replace Outcome_order = 2 if Outcome == "breadth"
    replace Outcome_order = 3 if Outcome == "time"
    replace Outcome_order = 4 if Outcome == "aug"
    replace Outcome_order = 5 if Outcome == "pressure"
    format Odds_ratio Log_SE P_value CI_low CI_high %9.3f
    save `t15_focal_results', replace
restore

foreach AI in GAI PAI {
    local AI_sheet "Generative AI"
    if "`AI'" == "PAI" local AI_sheet "Specialised AI"
    preserve
        use `t15_focal_results', clear
        keep if AI == "`AI'" & inlist(Outcome, "use", "breadth", "time")
        drop AI
        reshape wide Odds_ratio Log_SE P_value CI_low CI_high, ///
            i(Outcome Outcome_order Row_order Coef Predictor) j(Model)
        sort Outcome_order Row_order
        order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
            CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
            CI_low2 CI_high2 Odds_ratio3 Log_SE3 P_value3         ///
            CI_low3 CI_high3
        export excel using "$t15_excel",                  ///
            sheet("`AI_sheet' incorporation") firstrow(variables) sheetreplace
    restore

    preserve
        use `t15_focal_results', clear
        keep if AI == "`AI'" & inlist(Outcome, "aug", "pressure")
        drop AI
        reshape wide Odds_ratio Log_SE P_value CI_low CI_high, ///
            i(Outcome Outcome_order Row_order Coef Predictor) j(Model)
        sort Outcome_order Row_order
        if "`AI'" == "GAI" {
            order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
                CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
                CI_low2 CI_high2 Odds_ratio3 Log_SE3 P_value3         ///
                CI_low3 CI_high3
        }
        else {
            order Outcome Predictor Coef Odds_ratio1 Log_SE1 P_value1 ///
                CI_low1 CI_high1 Odds_ratio2 Log_SE2 P_value2         ///
                CI_low2 CI_high2
        }
        export excel using "$t15_excel",                  ///
            sheet("`AI_sheet' consequences") firstrow(variables) sheetreplace
    restore
}

preserve
    use `t15_model_tests', clear
    label variable P_position "Joint p: employment/student position"
    label variable P_industry "Joint p: industry field"
    label variable P_policy "Joint p: AI+ fields among employed"
    label variable P_key_vs_priority "p: key industrial = other priority"
    format P_position P_industry P_policy P_key_vs_priority %9.4f
    export excel using "$t15_excel", sheet("Model tests") ///
        firstrow(varlabels) sheetreplace
restore


