    inlist(`paipressure', 0, 1)

label define t15_yesno_lbl 0 "No" 1 "Yes", replace
label values t15_gai_use t15_pai_use                    ///
    t15_gai_aug t15_gai_pressure                        ///
    t15_pai_aug t15_pai_pressure t15_yesno_lbl

