    "$t15_tables/Table5B_PAI_AIplus_alignment.rtf",  ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Use M1" "Use M2" "Use M3"               ///
            "Breadth M1" "Breadth M2" "Breadth M3"   ///
            "Time M1" "Time M2" "Time M3")           ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_priority,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: institutional field"        ///
                 "Joint p: AI+ fields among employed"  ///
                 "p: key industrial = other priority")) ///
    title("Table 5B. Institutional field, AI+ alignment, and Specialised AI incorporation") ///
    addnotes(`table_notes')

esttab T15_GAI_AUG_M1 T15_GAI_AUG_M2 T15_GAI_AUG_M3   ///
       T15_GAI_PRESSURE_M1 T15_GAI_PRESSURE_M2         ///
       T15_GAI_PRESSURE_M3 using                       ///
    "$t15_tables/Table5C_GAI_industry_consequences.rtf", ///
    replace eform label b(3) se(3) nobaselevels noomitted ///
    star(* 0.05 ** 0.01 *** 0.001)                     ///
    keep(`keep_detail', relax)                          ///
    mtitles("Augmentation M1" "Augmentation M2"        ///
            "Augmentation M3" "Pressure M1"           ///
            "Pressure M2" "Pressure M3")              ///
    stats(N N_clust P_position P_industry P_policy      ///
          P_key_vs_priority,                            ///
          labels("Observations" "City clusters"        ///
                 "Joint p: employment/student position" ///
                 "Joint p: institutional field"        ///
                 "Joint p: AI+ fields among employed"  ///
